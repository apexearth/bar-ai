# What a tagged release builds from. .github/workflows/release.yml reads this.
# ENGINE_REF is the source the AI compiles against; ENGINE_NAME is the BAR
# engine folder it is installed into. They must agree on the C++ wrapper's ABI:
# RecoilEngine 1a03e748 (2026-07-15, in 2026.07.04 and not in 2026.06.12) made
# AIFloat3's copy constructor trivial ("must be trivial - same as float3,
# otherwise it ruins bindings"), and InitScript.cpp registers AIFloat3 with
# AngelScript as a POD all-floats class. Compiled against 2026.06.12, the SysV
# x86-64 ABI passes the non-trivial AIFloat3 by hidden reference while the
# script engine passes it in XMM registers: the v0.5.04 Linux release segfaults
# inside libSkirmishAI.so at the first script update (frame 1). Windows x64
# passes a 12-byte struct by reference either way, so the DLL never showed it.
ENGINE_REPO=https://github.com/beyond-all-reason/RecoilEngine.git
ENGINE_REF=2026.07.04
ENGINE_NAME=recoil_2026.07.04
CIRCUITAI_REPO=https://github.com/apexearth/CircuitAI.git
CIRCUITAI_SHA=b210d60e93880de0fbdfe3634ea98d5c0ed853aa
BUILD_IMAGE=ghcr.io/beyond-all-reason/recoil-build-amd64-windows@sha256:3ba630ac0c181a95dde522c3a4a81df2302914c7c4e6674e6bde0d4f6bf058ef
VARIANT=v0.5.06
BUILD_IMAGE_LINUX=ghcr.io/beyond-all-reason/recoil-build-amd64-linux@sha256:31b3667ba0d37620b4ad9b45d1840c8d3e95317f2b233044d2e17697ce8fe61d
