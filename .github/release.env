# What a tagged release builds from. .github/workflows/release.yml reads this.
# ENGINE_REF is the source the DLL compiles against; ENGINE_NAME is the BAR
# engine folder it is installed into. They differ on purpose: the AI interface
# did not change between them, and the local build has run that way since 08-02.
ENGINE_REPO=https://github.com/beyond-all-reason/RecoilEngine.git
ENGINE_REF=2026.06.12
ENGINE_NAME=recoil_2026.07.04
CIRCUITAI_REPO=https://github.com/apexearth/CircuitAI.git
CIRCUITAI_SHA=3739718c86ac432d3360ee961485f0d00925002c
BUILD_IMAGE=ghcr.io/beyond-all-reason/recoil-build-amd64-windows@sha256:3ba630ac0c181a95dde522c3a4a81df2302914c7c4e6674e6bde0d4f6bf058ef
VARIANT=v0.1.8
