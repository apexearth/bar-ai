+DM_STAT = re.compile(r"target=[\d.]+->([\d.]+) have=([\d.]+)")
+STRUCT_DIED = re.compile(r"unit-destroyed \w+ .*?cost=([\d.]+) fwd=(-?[\d.]+) .*?mob=0")
