+// STRONG DEFENCES AGAINST A HEAVY ARMY (his 11-16, docs/doctrine.md: a medium army behind strong defences that they
+// bleed into; and Ticks killing extractors one light turret would save). The nets learned against BARb, which rarely
+// raids a field, and tilted a turret 5-30x under an extractor (scenario ticks_mexes: turret gain 81 vs extractor 62,
+// net x1.6 vs x51). Once their raiders are seen or their believed army outweighs ours, a ground turret keeps at least
+// the election's typical net tilt: the nets still rank it, they cannot bury it.
+int gDnfOn = -1;
+int gDnfAt = -1;
+bool gDnfLive = false;
+int gDnfLifted = 0, gDnfElections = 0, gDnfLogAt = 0;
+void DefNnFloor(array<Want@>@ ranked)
+{
+	if (gDnfOn < 0)
+		gDnfOn = (ai.GetTunable("apex_def_nn_floor", TUNE_DEF_NN_FLOOR) > 0.f) ? 1 : 0;
+	if ((gDnfOn == 0) || (ranked.length() < 2))
+		return;
+	if (ai.frame >= gDnfAt) {
+		gDnfAt = ai.frame + 5 * SECOND;
+		const float raidSeen = Military::EnemyCostOf(Unit::Role::RAIDER.type)
+				+ Military::EnemyCostOf(Unit::Role::SCOUT.type);
+		gDnfLive = (raidSeen > 0.f) || (Military::FoeArmyM() > Military::OurArmyM());
+	}
+	if (!gDnfLive)
+		return;
+	++gDnfElections;
+	float lsum = 0.f;
+	int n = 0;
+	for (uint r = 0; r < ranked.length(); ++r) {
+		if ((ranked[r].value > 0.f) && (ranked[r].nnMult > 0.f)) {
+			lsum += log(ranked[r].nnMult);
+			++n;
+		}
+	}
+	if (n < 2)
+		return;
+	const float typical = pow(2.7182818f, lsum / float(n));
+	bool moved = false;
+	for (uint r = 0; r < ranked.length(); ++r) {
+		Want@ w = ranked[r];
+		if ((w.kind != WK_PROTECT) || (w.def is null) || (w.value <= 0.f) || (w.nnMult <= 0.f)
+			|| (ProtClassOf(int(w.def.id)) != PROT_DEF) || (w.nnMult >= typical))
+			continue;
+		const float m = typical / w.nnMult;
+		w.value *= m;
+		w.nnMult *= m;
+		moved = true;
+		++gDnfLifted;
+	}
+	if (moved) {
+		for (uint r = 1; r < ranked.length(); ++r) {
+			Want@ w = ranked[r];
+			uint at = r;
+			while ((at > 0) && (ranked[at - 1].value < w.value)) {
+				@ranked[at] = ranked[at - 1];
+				--at;
+			}
+			@ranked[at] = w;
+		}
+	}
+	if (ai.frame >= gDnfLogAt) {
+		gDnfLogAt = ai.frame + 60 * SECOND;
+		AiLog(Factory::T() + "apex: def-nn-floor t=" + ai.teamId + " elections=" + gDnfElections
+			+ " lifted=" + gDnfLifted + " typical=" + formatFloat(typical, "", 0, 2));
+	}
+}
