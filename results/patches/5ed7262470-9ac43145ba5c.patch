diff --git a/ai/Unstable/game-side/script/standard/manager/military/hooks.as b/ai/Unstable/game-side/script/standard/manager/military/hooks.as
index 5a514a89..36d6f597 100644
--- a/ai/Unstable/game-side/script/standard/manager/military/hooks.as
+++ b/ai/Unstable/game-side/script/standard/manager/military/hooks.as
@@ -412,6 +412,11 @@ int SpamSend(CCircuitUnit@ unit, const CCircuitDef@ cdef)
 	// while the T1 lab is still the ground army (no T2 land plant), its Pawns and Grunts are the army, not spam
 	if (!SpamSendOn() || !SpamPhase() || (Market::TopOwnLandPlantTier() < 2) || !IsFodder(cdef))
 		return 0;
+	// his 11-17: mid and late game we barely raid -- every raider became spam at the T2 plant (vs WRDistilled 12-18 min:
+	// 606 sent, 895 lost, 41 extractors killed; 18-24: 7). With this off a raider keeps the stock raid routing.
+	if (cdef.IsRoleAny(Unit::Role::RAIDER.mask)
+		&& (ai.GetTunable("apex_spam_send_raiders", TUNE_SPAM_SEND_RAIDERS) <= 0.f))
+		return 0;
 	const int id = int(unit.id);
 	if (id < 0)
 		return 0;
