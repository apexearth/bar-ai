+const float TUNE_SPAM_SEND_RAIDERS = 1.f;   // [toggle 0/1] hooks.as SpamSend: raider-role fodder is sent as spam after the T2 plant (0: it keeps raiding; his 11-17, A/B)
 const float TUNE_SPAM_SHELL = 1.f;   // [toggle 0/1] hooks.as SpamShellPick: late fodder moves to where fire on our structures comes from (his 11-07)
