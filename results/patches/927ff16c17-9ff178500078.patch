@@ -0,0 +1,58 @@
+#!/usr/bin/env python3
+"""When our AI's first radar tower stood, per AI seat, by game date (his 11-18: "We no longer seem to be making
+radar in the early game which makes it hard to deal with raiders"). Reads the replay recordings of his games
+(tools/replay_orders.py; F = finished) and the AI name from each demo's start script.
+
+    python tools/armynet/radar_history.py
+"""
+import collections
+import glob
+import gzip
+import re
+import sys
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(REPO / "tools"))
+import bar_env  # noqa: E402
+import replay_extract as rx  # noqa: E402
+
+RADAR = re.compile(r"^(arm|cor|leg)(rad|arad)$|^legrad", re.I)
+
+
+def main():
+    env = bar_env.load()
+    rows = []
+    for rec in sorted(glob.glob("G:/bar-ai-archive/replay-orders/*/orders.txt.gz")):
+        stem = Path(rec).parent.name
+        demo = env.data / "demos" / (stem + ".sdfz")
+        if not demo.exists():
+            continue
+        meta = rx.meta_of(rx.demo_script(demo))
+        ai = {a["team"]: "%s %s" % (a["short"], a["version"]) for a in meta["ais"]}
+        names, first, minutes = {}, {}, 0.0
+        for ln in gzip.open(rec, "rt", errors="replace"):
+            p = ln.split()
+            if p[0] == "D":
+                names[int(p[1])] = p[2]
+            elif p[0] == "F":
+                t = int(p[4])
+                if t in ai and RADAR.match(names.get(int(p[3]), "")) and t not in first:
+                    first[t] = int(p[1]) / 1800.0
+                minutes = max(minutes, int(p[1]) / 1800.0)
+        for t, name in ai.items():
+            if name.startswith("Apex"):
+                rows.append((stem[:10], name, first.get(t), minutes))
+    by = collections.defaultdict(list)
+    for date, name, f, mins in rows:
+        by[(date, name)].append(f)
+    print("%-11s %-24s %5s %10s %16s" % ("date", "AI", "seats", "no radar", "first radar min"))
+    for (date, name), fs in sorted(by.items()):
+        got = sorted(f for f in fs if f is not None)
+        med = got[len(got) // 2] if got else None
+        print("%-11s %-24s %5d %10d %16s" % (date, name[:24], len(fs), len(fs) - len(got),
+                                             "%.1f" % med if med is not None else "-"))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/armynet/serve.py b/tools/armynet/serve.py
new file mode 100644
index 00000000..44126a2e
--- /dev/null
+++ b/tools/armynet/serve.py
@@ -0,0 +1,149 @@
+#!/usr/bin/env python3
+"""Run the army model for a local game through game-patches/gadgets/dev_armynet.lua.
+
+    python tools/armynet/serve.py --dir <the game's write dir> --model runtime/armynet/<run>/model.pt [--seed 1]
+
+Reads armynet_static.txt once and armynet_state.txt each time its frame advances; answers in armynet_orders.txt
+(written whole, then renamed). Our AI's units count as ours in the view, as a player's own units did in training;
+orders go to the holder's units only. Each unit takes a new order with the probability the model gives (players
+give one about every ten seconds per unit); the kind and place are the model's best.
+"""
+import os
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from data import CLASSES, G, MEMORY_S, Game, collate  # noqa: E402
+from model import ArmyNet  # noqa: E402
+
+KIND_CMD = {0: 0, 1: 10, 2: 16, 3: 20, 4: 16, 5: 15}
+
+
+def read_static(d):
+    defs, teams, allies, spots, holders, heights, mapxz = [], [], [], [], [], None, (0, 0)
+    for ln in open(d / "armynet_static.txt", encoding="utf-8", errors="replace"):
+        p = ln.split()
+        if not p:
+            continue
+        if p[0] == "D":
+            defs.append([float(p[1]), float(CLASSES.index(p[3]) if p[3] in CLASSES else 7)] + [float(v) for v in p[4:13]])
+        elif p[0] == "T":
+            teams.append([int(p[1]), int(p[2]), p[3] == "true", 35.0])
+        elif p[0] == "A":
+            allies = [int(v) for v in p[1:]]
+        elif p[0] == "Q":
+            holders.append((int(p[1]), int(p[2])))
+        elif p[0] == "S":
+            spots.append((float(p[2]), float(p[3])))
+        elif p[0] == "V":
+            mapxz = (int(p[2]), int(p[3]))
+        elif p[0] == "H":
+            step = int(p[1])
+            h = np.array([float(v) for v in p[2:]], np.float32)
+            nx = len(range(step // 2, mapxz[0] + 1, step))
+            heights = h[: (len(h) // nx) * nx].reshape(-1, nx)
+    return (np.array(defs, np.float32), teams, allies, np.array(spots, np.float32).reshape(-1, 2), holders,
+            heights if heights is not None else np.zeros((0, 0), np.float32), mapxz)
+
+
+def read_state(d, last):
+    try:
+        text = (d / "armynet_state.txt").read_text(encoding="utf-8", errors="replace")
+    except OSError:
+        return None, None
+    lines = text.splitlines()
+    if len(lines) < 2 or not lines[0].startswith("F ") or not lines[-1].startswith("E "):
+        return None, None
+    frame = int(lines[0].split()[1])
+    if frame <= last:
+        return None, None
+    rows = [[float(v) for v in ln.split()[1:15]] for ln in lines[1:-1] if ln.startswith("U ")]
+    return frame, np.array(rows, np.float32).reshape(-1, 14)
+
+
+def main(a):
+    def opt(name, default):
+        return a[a.index(name) + 1] if name in a else default
+    d = Path(opt("--dir", "."))
+    dev = "cuda" if torch.cuda.is_available() else "cpu"
+    model = ArmyNet().to(dev)
+    model.load_state_dict(torch.load(opt("--model", ""), map_location=dev))
+    model.eval()
+    rng = np.random.default_rng(int(opt("--seed", "1")))
+    while not (d / "armynet_static.txt").exists():
+        time.sleep(1)
+    time.sleep(1)
+    defs, teams, allies, spots, holders, heights, mapxz = read_static(d)
+    if not holders:
+        sys.exit("no holder seat in the game: add --extra-ai NullAI@<our ally> and --modoption dev_armynet=1")
+    team_arr = np.array(teams, np.float32)
+    print("map %s, holders %s, device %s" % (mapxz, holders, dev), flush=True)
+    history, last = [], -1
+    while True:
+        frame, rows = read_state(d, last)
+        if frame is None:
+            time.sleep(0.05)
+            continue
+        last = frame
+        history.append(rows)
+        while len(history) > 1 and (not len(history[0]) or history[0][0, 0] < frame - MEMORY_S * 30):
+            history.pop(0)
+        units = np.concatenate(history)
+        out = ["O %d" % frame]
+        for holder, source in holders:
+            u = units.copy()
+            u[u[:, 3] == source, 3] = holder
+            g = Game.live(u, defs, mapxz, allies, team_arr, spots, heights)
+            ex = g.example(holder, frame)
+            if not len(ex["tok"]):
+                continue
+            b = collate([ex])
+            with torch.no_grad():
+                o = model(b["grid"].to(dev), b["scal"].to(dev), b["tok"].to(dev), b["mask"].to(dev))
+                p = torch.sigmoid(o["act"][0]).cpu().numpy()
+                kind = o["kind"][0].argmax(-1).cpu().numpy()
+                cell = o["cells"][0].argmax(-1)
+                off = model.offset_at(o["h"], o["u64"], cell[None])[0].cpu().numpy()
+                cell = cell.cpu().numpy()
+            sx, sz = mapxz[0] / G, mapxz[1] / G
+            here = units[units[:, 0] == frame]
+            for j, uid in enumerate(ex["uid"]):
+                if rng.random() >= p[j]:
+                    continue
+                k = int(kind[j])
+                x = (cell[j] % G + off[j, 0]) * sx
+                z = (cell[j] // G + off[j, 1]) * sz
+                cmd = KIND_CMD[k]
+                if cmd == 0:
+                    out.append("%d,0" % uid)
+                    continue
+                if cmd == 20:
+                    foe = here[(np.array([g.ally_of.get(int(t), -9) for t in here[:, 3]]) != g.ally_of[holder])]
+                    if len(foe):
+                        dd = (foe[:, 4] - x) ** 2 + (foe[:, 5] - z) ** 2
+                        i = int(np.argmin(dd))
+                        if dd[i] < 400 ** 2:
+                            out.append("%d,20,%d" % (uid, int(foe[i, 1])))
+                            continue
+                    cmd = 16
+                out.append("%d,%d,%.0f,%.0f" % (uid, cmd, x, z))
+            if frame % 300 == 0:
+                print("frame %d units %d new orders %d mean p %.2f" % (frame, len(ex["uid"]), len(out) - 1, p.mean()),
+                      flush=True)
+        out.append("E")
+        tmp = d / "armynet_orders.tmp"
+        tmp.write_text("\n".join(out) + "\n", encoding="utf-8")
+        for _ in range(50):
+            try:
+                os.replace(tmp, d / "armynet_orders.txt")
+                break
+            except PermissionError:  # the game has the file open for a moment
+                time.sleep(0.01)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
diff --git a/tools/armynet/train.py b/tools/armynet/train.py
new file mode 100644
index 00000000..4958d036
--- /dev/null
+++ b/tools/armynet/train.py
@@ -0,0 +1,248 @@
+#!/usr/bin/env python3
+"""Train the army model on replay examples; evaluate on whole held-out games against plain rules.
+
+    python tools/armynet/train.py [--roots DIR ...] [--steps 20000] [--batch 32] [--out runtime/armynet/<name>]
+    python tools/armynet/train.py --eval-only <model.pt> [--roots ...]
+
+Roots default to both recording sets on G:. Every 10th game (by name hash) is held out. The evaluation reports, on
+held-out examples: the keep/new log loss against the base rate; the kind accuracy against "always move"; and the
+median distance in elmos from the predicted place to the player's, against "keep the current target or stand" and
+"go to the nearest enemy in sight".
+"""
+import hashlib
+import math
+import os
+import random
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from data import G, Game, collate, find_games  # noqa: E402
+from model import ArmyNet  # noqa: E402
+
+REPO = Path(__file__).resolve().parents[2]
+ROOTS = ["G:/bar-ai-archive/public-replays/recordings", "G:/bar-ai-archive/replay-orders"]
+
+
+def his_game():
+    sys.path.insert(0, str(REPO / "tools"))
+    import mp_archive
+    return mp_archive.his_game_running()
+
+
+def held_out(path):
+    return int(hashlib.md5(Path(path).name.encode()).hexdigest(), 16) % 10 == 0
+
+
+class Stream(torch.utils.data.IterableDataset):
+    """Examples from random training games; with roots given, the game list is re-read every 10 minutes so new
+    recordings join a running training (held-out games stay out)."""
+
+    def __init__(self, games, per_game=64, seed=0, roots=None):
+        self.games, self.per_game, self.seed, self.roots = games, per_game, seed, roots
+
+    def __iter__(self):
+        info = torch.utils.data.get_worker_info()
+        rng = random.Random(self.seed + (info.id if info else 0) + int(time.time()))
+        buf = []
+        games, scanned = self.games, time.time()
+        while True:
+            if self.roots and time.time() - scanned > 600:
+                fresh = [p for p in find_games(self.roots) if not held_out(p)]
+                if fresh:
+                    games = fresh
+                scanned = time.time()
+            path = rng.choice(games)
+            try:
+                g = Game(path, rng=np.random.default_rng(rng.randrange(1 << 30)))
+            except Exception as e:
+                print("skip", path, e, flush=True)
+                continue
+            if not g.examples:
+                continue
+            for t, f in rng.sample(g.examples, min(self.per_game, len(g.examples))):
+                ex = g.example(t, f)
+                if len(ex["tok"]):
+                    buf.append(ex)
+            rng.shuffle(buf)
+            while len(buf) > 256:
+                yield buf.pop()
+
+
+def losses(model, b, dev):
+    b = {k: v.to(dev) for k, v in b.items()}
+    o = model(b["grid"], b["scal"], b["tok"], b["mask"])
+    m = b["mask"].float()
+    wr = b["w_rating"][:, None]
+    l_act = (F.binary_cross_entropy_with_logits(o["act"], b["act"], reduction="none") * m * wr).sum() / m.sum()
+    new = (b["act"] > 0) & b["mask"]
+    w = (b["w_out"] * wr)[new]
+    if new.any():
+        l_kind = (F.cross_entropy(o["kind"][new], b["kind"][new].clamp(min=0), reduction="none") * w).sum() / w.sum()
+        l_cell = (F.cross_entropy(o["cells"][new], b["tcell"][new].clamp(min=0), reduction="none") * w).sum() / w.sum()
+        off = model.offset_at(o["h"], o["u64"], b["tcell"])[new]
+        l_off = ((off - b["toff"][new]).abs().sum(-1) * w).sum() / w.sum()
+    else:
+        l_kind = l_cell = l_off = torch.zeros((), device=dev)
+    return l_act + l_kind + l_cell + l_off, {"act": l_act.item(), "kind": l_kind.item(), "cell": l_cell.item(),
+                                             "off": l_off.item()}
+
+
+def base_axis(grid, sx, sz, mapx, mapz):
+    """How far forward a point is: 0 at our buildings' centre, 1 at theirs (the enemy buildings the side has seen; the
+    mirror of ours through the map centre when it has seen none)."""
+    def centre(ch):
+        w = np.expm1(np.clip(ch, 0, 20))
+        if w.sum() <= 0:
+            return None
+        zz, xx = np.mgrid[0:G, 0:G]
+        return ((xx + .5) * w).sum() / w.sum() * sx, ((zz + .5) * w).sum() / w.sum() * sz
+    own = centre(grid[3]) or (mapx / 2, mapz / 2)
+    foe = centre(grid[8]) or (mapx - own[0], mapz - own[1])
+    ax, az = foe[0] - own[0], foe[1] - own[1]
+    n2 = max(ax * ax + az * az, 1.0)
+    return lambda x, z: ((x - own[0]) * ax + (z - own[1]) * az) / n2
+
+
+@torch.no_grad()
+def evaluate(model, games, dev, n_games=40, per_game=40):
+    model.eval()
+    rng = random.Random(1)
+    games = games[:]
+    rng.shuffle(games)
+    acts, preds, kinds_t, kinds_p = [], [], [], []
+    d_model, d_keep, d_enemy, d_order = [], [], [], []
+    fwd_model, fwd_player = [], []
+    for path in games[:n_games]:
+        g = Game(path, rng=np.random.default_rng(7))
+        if not g.examples:
+            continue
+        exs = [g.example(t, f) for t, f in rng.sample(g.examples, min(per_game, len(g.examples)))]
+        exs = [e for e in exs if len(e["tok"])]
+        if not exs:
+            continue
+        b = collate(exs)
+        bd = {k: v.to(dev) for k, v in b.items()}
+        o = model(bd["grid"], bd["scal"], bd["tok"], bd["mask"])
+        msk = b["mask"].numpy()
+        acts.append(b["act"].numpy()[msk])
+        preds.append(torch.sigmoid(o["act"]).cpu().numpy()[msk])
+        new = (b["act"].numpy() > 0) & msk
+        if not new.any():
+            continue
+        kinds_t.append(b["kind"].numpy()[new])
+        kinds_p.append(o["kind"].argmax(-1).cpu().numpy()[new])
+        cell = o["cells"].argmax(-1)
+        off = model.offset_at(o["h"], o["u64"], cell).cpu().numpy()
+        cell = cell.cpu().numpy()
+        tok = b["tok"].numpy()
+        grid = b["grid"].numpy()
+        axes = {}
+        for i, j in zip(*np.where(new)):
+            sx, sz = g.mapx / G, g.mapz / G
+            if i not in axes:
+                axes[i] = base_axis(grid[i], sx, sz, g.mapx, g.mapz)
+            tc = int(b["tcell"][i, j])
+            tx = (tc % G + float(b["toff"][i, j, 0])) * sx
+            tz = (tc // G + float(b["toff"][i, j, 1])) * sz
+            px = (cell[i, j] % G + off[i, j, 0]) * sx
+            pz = (cell[i, j] // G + off[i, j, 1]) * sz
+            ux, uz = tok[i, j, 10] * g.mapx, tok[i, j, 11] * g.mapz
+            if tok[i, j, 21] > 0:
+                kx, kz = ux + tok[i, j, 22] * 2000, uz + tok[i, j, 23] * 2000
+            else:
+                kx, kz = ux, uz
+            ev = np.argwhere(np.expm1(grid[i, 7]) > 0)
+            if len(ev):
+                cz_, cx_ = ev[np.argmin(((ev[:, 1] + .5) * sx - ux) ** 2 + ((ev[:, 0] + .5) * sz - uz) ** 2)]
+                ex_, ez_ = (cx_ + .5) * sx, (cz_ + .5) * sz
+            else:
+                ex_, ez_ = kx, kz
+            d_model.append(math.hypot(px - tx, pz - tz))
+            d_keep.append(math.hypot(kx - tx, kz - tz))
+            d_enemy.append(math.hypot(ex_ - tx, ez_ - tz))
+            d_order.append(math.hypot(ux - tx, uz - tz))
+            fwd_model.append(axes[i](px, pz))
+            fwd_player.append(axes[i](tx, tz))
+    model.train()
+    a, p = np.concatenate(acts), np.clip(np.concatenate(preds), 1e-6, 1 - 1e-6)
+    base = a.mean()
+    ll = -np.mean(a * np.log(p) + (1 - a) * np.log(1 - p))
+    ll0 = -np.mean(a * np.log(base) + (1 - a) * np.log(1 - base))
+    kt, kp = np.concatenate(kinds_t), np.concatenate(kinds_p)
+    med = lambda v: float(np.median(v)) if v else float("nan")
+    return {"tokens": len(a), "new_rate": round(float(base), 4), "act_logloss": round(float(ll), 4),
+            "act_logloss_base": round(float(ll0), 4), "kind_acc": round(float((kt == kp).mean()), 3),
+            "kind_acc_always_move": round(float((kt == 1).mean()), 3), "orders": len(d_model),
+            "dist_model": round(med(d_model)), "dist_keep_or_stand": round(med(d_keep)),
+            "dist_nearest_enemy": round(med(d_enemy)), "order_length": round(med(d_order)),
+            "forward_model": round(med(fwd_model), 2), "forward_player": round(med(fwd_player), 2),
+            "forward_model_q75": round(float(np.percentile(fwd_model, 75)), 2) if fwd_model else None,
+            "forward_player_q75": round(float(np.percentile(fwd_player, 75)), 2) if fwd_player else None}
+
+
+def main(a):
+    def opt(name, default):
+        return a[a.index(name) + 1] if name in a else default
+    roots = [a[i + 1] for i, x in enumerate(a) if x == "--roots"] or ROOTS
+    games = find_games(roots)
+    train = [g for g in games if not held_out(g)]
+    test = [g for g in games if held_out(g)] or train[:2]
+    dev = "cuda" if torch.cuda.is_available() else "cpu"
+    print("games: %d train, %d held out; device %s" % (len(train), len(test), dev), flush=True)
+    model = ArmyNet().to(dev)
+    if "--eval-only" in a:
+        model.load_state_dict(torch.load(opt("--eval-only", ""), map_location=dev))
+        print(evaluate(model, test, dev))
+        return 0
+    steps = int(opt("--steps", "20000"))
+    out = Path(opt("--out", str(REPO / "runtime" / "armynet" / time.strftime("%Y%m%d-%H%M"))))
+    out.mkdir(parents=True, exist_ok=True)
+    if "--init" in a:
+        model.load_state_dict(torch.load(opt("--init", ""), map_location=dev))
+    save_every = int(opt("--save-every", "0"))
+    dl = torch.utils.data.DataLoader(Stream(train, roots=roots if "--refresh" in a else None),
+                                     batch_size=int(opt("--batch", "32")), collate_fn=collate,
+                                     num_workers=int(opt("--workers", "4")), persistent_workers=int(opt("--workers", "4")) > 0)
+    optim = torch.optim.AdamW(model.parameters(), lr=3e-4, weight_decay=0.01)
+    if "--constant-lr" in a:  # an open-ended run: warm up, then hold
+        sched = torch.optim.lr_scheduler.LambdaLR(optim, lambda s: min(1.0, (s + 1) / 500) * 0.67)
+    else:
+        sched = torch.optim.lr_scheduler.OneCycleLR(optim, 3e-4, total_steps=steps, pct_start=0.05)
+    t0, agg = time.time(), {}
+    for step, b in enumerate(dl, 1):
+        loss, parts = losses(model, b, dev)
+        optim.zero_grad()
+        loss.backward()
+        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
+        optim.step()
+        sched.step()
+        for k, v in parts.items():
+            agg[k] = agg.get(k, 0) + v
+        if step % 200 == 0 and his_game():
+            print("his game is running: paused", flush=True)
+            while his_game():
+                time.sleep(120)
+        if step % 200 == 0:
+            print("step %d %.0fs " % (step, time.time() - t0) + " ".join("%s %.3f" % (k, v / 200) for k, v in agg.items()),
+                  flush=True)
+            agg = {}
+        if step % 2000 == 0 or step == steps:
+            torch.save(model.state_dict(), out / "model.pt")
+            print("eval", evaluate(model, test, dev), flush=True)
+        if save_every and step % save_every == 0:
+            torch.save(model.state_dict(), out / ("model-%06d.tmp" % step))
+            os.replace(out / ("model-%06d.tmp" % step), out / ("model-%06d.pt" % step))
+            print("checkpoint", step, flush=True)
+        if step >= steps:
+            break
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
