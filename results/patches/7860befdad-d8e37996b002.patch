index 00000000..a43145a0
--- /dev/null
+++ b/tools/base_audit.py
@@ -0,0 +1,203 @@
+#!/usr/bin/env python3
+"""How each seat built, humans against our AI, from a replay recording (tools/replay_orders.py one <demo> <dir>).
+
+His 11-22, after online games our seats lost to the humans' T3: "humans will build far more efficient patterns of
+buildings than the AI does ... you're creating small, inefficient gaps in the build grid", "how much open ground is in
+their base by percentage", land value ("fully packed in, but ... advanced solar and basic energy converters, whereas
+... advanced fusions and advanced energy converters"), and "it oftentimes just takes one human player to go crazy
+powerful and it's enough to beat all of the AI" -- so every figure is per seat, best seat against best seat.
+
+    python tools/base_audit.py <recording dir or orders.txt.gz> ... [--minutes 20,30]
+
+Per seat:
+  finished   metal of every unit it finished; the shares in air, anti-air, T3 (gantry-built, 1,500+ metal)
+  first T3   the minute its first T3 unit finished
+  at each minute, its standing buildings but extractors and geos, at their unit-file footprints:
+  flush / gap  the nearest other building's edge gap: 0 squares, or 1-2 (the small wasted gaps)
+  open         open ground in its main base: 1 - footprint / hull of its biggest cluster (buildings within 10 build
+               squares of each other)
+  E/sq         energy made per build square of its energy buildings (wind at half its rating)
+  m/sq         metal converted per build square of its converters
+"""
+import collections
+import glob
+import gzip
+import re
+import sys
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import bar_env  # noqa: E402
+
+GANTRY_BUILDS = set("armbanth armcroc armlun armmar armraz armthor armvang corcat cordemon corjugg corkarg corkorg "
+                    "corparrow corsala corshiva corsok legamph leganavybattleship legeallterrainmech legeheatraymech "
+                    "legehovertank legelrpcmech legerailtank legeshotgunmech legfloat legjav legkeres".split())
+_file = {}
+
+
+def unit_file(name):
+    if name not in _file:
+        units = bar_env.load().game_sdd / "units"
+        hits = glob.glob(str(units / "**" / (name + ".lua")), recursive=True)
+        _file[name] = open(hits[0], encoding="utf-8", errors="replace").read() if hits else ""
+    return _file[name]
+
+
+def num(txt, key):
+    r = re.search(key + r"\s*=\s*(-?[\d.]+)(?:\s*/\s*([\d.]+))?", txt, re.I)
+    return float(r.group(1)) / (float(r.group(2)) if r.group(2) else 1.0) if r else 0.0
+
+
+def foot(name):
+    txt = unit_file(name)
+    return int(num(txt, "footprintx") or 2), int(num(txt, "footprintz") or 2)
+
+
+def output(name):
+    txt = unit_file(name)
+    e = num(txt, "energymake") or max(-num(txt, "energyupkeep"), 0.0) or 0.5 * num(txt, "windgenerator")
+    return e, num(txt, "energyconv_capacity") * num(txt, "energyconv_efficiency")
+
+
+def hull_area(pts):
+    pts = sorted(set(map(tuple, pts)))
+    if len(pts) < 3:
+        return 0.0
+
+    def cross(o, a, b):
+        return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])
+    lo, hi = [], []
+    for p in pts:
+        while len(lo) >= 2 and cross(lo[-2], lo[-1], p) <= 0:
+            lo.pop()
+        lo.append(p)
+    for p in reversed(pts):
+        while len(hi) >= 2 and cross(hi[-2], hi[-1], p) <= 0:
+            hi.pop()
+        hi.append(p)
+    h = lo[:-1] + hi[:-1]
+    return 0.5 * abs(sum(h[i][0] * h[(i + 1) % len(h)][1] - h[(i + 1) % len(h)][0] * h[i][1] for i in range(len(h))))
+
+
+def layout(blds):
+    """blds: (x, z, half x, half z, name). Returns (flush share, small-gap share, open ground, E/sq, m/sq, top energy)."""
+    a = np.array([b[:4] for b in blds], float)
+    gaps = np.full(len(a), np.inf)
+    for i in range(len(a)):
+        g = np.maximum(np.maximum(np.abs(a[:, 0] - a[i, 0]) - a[:, 2] - a[i, 2],
+                                  np.abs(a[:, 1] - a[i, 1]) - a[:, 3] - a[i, 3]), 0)
+        g[i] = np.inf
+        gaps[i] = g.min() / 16.0
+    lab = -np.ones(len(a), int)
+    c = 0
+    for i in range(len(a)):
+        if lab[i] >= 0:
+            continue
+        lab[i], st = c, [i]
+        while st:
+            k = st.pop()
+            near = np.maximum(np.abs(a[:, 0] - a[k, 0]) - a[:, 2] - a[k, 2],
+                              np.abs(a[:, 1] - a[k, 1]) - a[:, 3] - a[k, 3]) <= 160
+            for j in np.where(near & (lab < 0))[0]:
+                lab[j] = c
+                st.append(j)
+        c += 1
+    fpa = 4 * a[:, 2] * a[:, 3]
+    m = lab == np.bincount(lab, weights=fpa).argmax()
+    area = hull_area([(x + sx * hx, z + sz * hz) for x, z, hx, hz in a[m] for sx in (-1, 1) for sz in (-1, 1)])
+    e = e_sq = mc = m_sq = 0.0
+    kinds = collections.Counter()
+    for b in blds:
+        sq = (b[2] / 8) * (b[3] / 8)
+        eo, mo = output(b[4])
+        if eo > 0:
+            e, e_sq = e + eo, e_sq + sq
+            kinds[b[4]] += sq
+        if mo > 0:
+            mc, m_sq = mc + mo, m_sq + sq
+    top = ",".join(k for k, _ in kinds.most_common(2))
+    return ((gaps < 0.5).mean(), ((gaps >= 0.5) & (gaps < 2.5)).mean(), 1 - fpa[m].sum() / area if area else 0.0,
+            e / e_sq if e_sq else 0.0, mc / m_sq if m_sq else 0.0, top)
+
+
+def audit(path, minutes):
+    p = Path(path)
+    if p.is_dir():
+        p = p / "orders.txt.gz"
+    defs, teams, done = {}, {}, set()
+    fin = collections.defaultdict(collections.Counter)
+    first_t3, last = {}, 0
+    snap = {mm: {} for mm in minutes}
+    with gzip.open(p, "rt", errors="replace") as f:
+        for ln in f:
+            if ln.startswith("U "):
+                v = ln.split()
+                fr, uid, d, team, build = int(v[1]), int(v[2]), int(v[3]), int(v[4]), float(v[10])
+                last = fr
+                if d not in defs or build < 1.0:
+                    continue
+                for mm in minutes:
+                    if mm * 1800 - 300 < fr <= mm * 1800:
+                        snap[mm][uid] = (team, d, float(v[5]), float(v[6]))
+                if uid in done:
+                    continue
+                done.add(uid)
+                name, cls, metal, gdps, adps = defs[d]
+                k = "air" if cls == "air" else "aa" if adps > 0 and adps >= gdps else \
+                    "t3" if name in GANTRY_BUILDS and metal >= 1500 else "other"
+                fin[team][k] += metal
+                if k == "t3":
+                    first_t3.setdefault(team, fr / 1800)
+            elif ln.startswith("D "):
+                v = ln.split()
+                defs[int(v[1])] = (v[2], v[3], float(v[4]), float(v[8]), float(v[9]))
+            elif ln.startswith("T "):
+                v = ln.split()
+                teams[int(v[1])] = (int(v[2]), v[3] == "true")
+    lay = {}
+    for mm, units in snap.items():
+        per = collections.defaultdict(list)
+        for team, d, x, z in units.values():
+            name, cls = defs[d][:2]
+            if cls == "static" and not any(s in name for s in ("mex", "moho", "geo")) and not name.endswith("_meteor"):
+                fx, fz = foot(name)
+                per[team].append((x, z, fx * 8.0, fz * 8.0, name))
+        for t, blds in per.items():
+            if len(blds) >= 5:
+                lay[t, mm] = layout(blds)
+    print("== %s (%.0f min)" % (p.parent.name[:70], last / 1800))
+    hdr = "  seat side  finished   air  AA   T3 firstT3"
+    for mm in minutes:
+        hdr += " | m%d flush gap1-2 open  E/sq  m/sq" % mm
+    print(hdr)
+    rows = sorted((t for t in teams if t in fin), key=lambda t: -sum(fin[t].values()))
+    for t in rows:
+        s = sum(fin[t].values()) or 1
+        line = "  %4d %-5s %7dk %4.0f%% %3.0f%% %3.0f%% %7s" % (
+            t, "AI" if teams[t][1] else "human", s // 1000, 100 * fin[t]["air"] / s, 100 * fin[t]["aa"] / s,
+            100 * fin[t]["t3"] / s, "%.1f" % first_t3[t] if t in first_t3 else "-")
+        for mm in minutes:
+            if (t, mm) in lay:
+                fl, sg, op, e, mc, top = lay[t, mm]
+                line += " |    %3.0f%%   %3.0f%%  %3.0f%% %5.1f %5.2f" % (100 * fl, 100 * sg, 100 * op, e, mc)
+            else:
+                line += " |       -      -     -     -     -"
+        print(line)
+    for who in (False, True):
+        side = [t for t in rows if teams[t][1] == who]
+        if side:
+            best = side[0]
+            print("  best %s seat %d: %dk finished (side median %dk)" % (
+                "AI" if who else "human", best, sum(fin[best].values()) // 1000,
+                int(np.median([sum(fin[t].values()) for t in side])) // 1000))
+
+
+if __name__ == "__main__":
+    args = [x for x in sys.argv[1:] if not x.startswith("--")]
+    mins = [int(x) for x in (sys.argv[sys.argv.index("--minutes") + 1].split(",") if "--minutes" in sys.argv else
+                             ("20", "30"))]
+    args = [x for x in args if not re.fullmatch(r"[\d,]+", x)]
+    for a in args:
+        audit(a, mins)
diff --git a/tools/defs_dump_widget.lua b/tools/defs_dump_widget.lua
new file mode 100644
index 00000000..ca63a024
--- /dev/null
+++ b/tools/defs_dump_widget.lua
@@ -0,0 +1,98 @@
+function widget:GetInfo()
+	return { name = "BARAI defs dump", desc = "every UnitDef and its weapons, as the game itself has them, to defs.json",
+		author = "bar-ai", layer = 0, enabled = true }
+end
+
+-- his 11-22: "The model needs to know the unit's hp, range, damage, fire rate, movement speed, it needs to understand
+-- all the factors". Run once per game version (tools/defs_dump.py); the army net's stats come from this file.
+
+local function esc(s)
+	return '"' .. tostring(s):gsub('\\', '\\\\'):gsub('"', '\\"') .. '"'
+end
+
+local function val(v)
+	local t = type(v)
+	if t == "number" then
+		if v ~= v or v == math.huge or v == -math.huge then return "0" end
+		return string.format("%.6g", v)
+	elseif t == "boolean" then
+		return v and "true" or "false"
+	elseif t == "string" then
+		return esc(v)
+	end
+	return "null"
+end
+
+local function weapon(w)
+	local wd = WeaponDefs[w.weaponDef]
+	if not wd then return nil end
+	local dmg = {}
+	for i = 0, #(Game.armorTypes or {}) do
+		local d = 0
+		pcall(function() d = wd.damages[i] or 0 end)
+		dmg[#dmg + 1] = val(d)
+	end
+	local only, bad = {}, {}
+	for k, on in pairs(w.onlyTargets or {}) do if on then only[#only + 1] = esc(k) end end
+	for k, on in pairs(w.badTargets or {}) do if on then bad[#bad + 1] = esc(k) end end
+	local f = {
+		'"name":' .. esc(wd.name), '"type":' .. esc(wd.type), '"range":' .. val(wd.range),
+		'"reload":' .. val(wd.reload), '"salvo":' .. val(wd.salvoSize), '"projectiles":' .. val(wd.projectiles),
+		'"aoe":' .. val(wd.damageAreaOfEffect), '"edge":' .. val(wd.edgeEffectiveness),
+		'"speed":' .. val(wd.projectilespeed), '"accuracy":' .. val(wd.accuracy), '"spray":' .. val(wd.sprayAngle),
+		'"paralyzer":' .. val(wd.paralyzer), '"high":' .. val(wd.highTrajectory), '"beamtime":' .. val(wd.beamtime),
+		'"stockpile":' .. val(wd.stockpile), '"water":' .. val(wd.waterWeapon), '"interceptor":' .. val(wd.interceptor),
+		'"selfexp":' .. val(wd.selfExplode), '"tracks":' .. val(wd.tracks), '"turret":' .. val(wd.turret),
+		'"heightmod":' .. val(wd.heightMod), '"cylinder":' .. val(wd.cylinderTargeting),
+		'"damages":[' .. table.concat(dmg, ",") .. ']', '"only":[' .. table.concat(only, ",") .. ']',
+		'"bad":[' .. table.concat(bad, ",") .. ']',
+	}
+	return "{" .. table.concat(f, ",") .. "}"
+end
+
+function widget:Initialize()
+	local wd = Spring.GetConfigString("BARAI_DEFS_OUT", "")
+	local path = (wd ~= "" and wd) or "defs.json"
+	local out = io.open(path, "w")
+	if not out then
+		Spring.Echo("[BARAI_DEFS] cannot open " .. path)
+		return
+	end
+	local armor = {}
+	for name, id in pairs(Game.armorTypes or {}) do
+		if type(name) == "string" then armor[#armor + 1] = '"' .. name .. '":' .. tostring(id) end
+	end
+	out:write('{"armor":{' .. table.concat(armor, ",") .. '},"units":{\n')
+	local first = true
+	for id, ud in pairs(UnitDefs) do
+		local ws = {}
+		for _, w in ipairs(ud.weapons or {}) do
+			local s = weapon(w)
+			if s then ws[#ws + 1] = s end
+		end
+		local shieldPower = 0
+		pcall(function()
+			if ud.shieldWeaponDef and WeaponDefs[ud.shieldWeaponDef] then
+				shieldPower = WeaponDefs[ud.shieldWeaponDef].shieldPower or 0
+			end
+		end)
+		local f = {
+			'"id":' .. id, '"metal":' .. val(ud.metalCost), '"energy":' .. val(ud.energyCost),
+			'"health":' .. val(ud.health), '"speed":' .. val(ud.speed), '"turn":' .. val(ud.turnRate),
+			'"accel":' .. val(ud.maxAcc), '"buildtime":' .. val(ud.buildTime), '"armor":' .. val(ud.armorType),
+			'"fly":' .. val(ud.canFly), '"cloak":' .. val(ud.canCloak), '"stealth":' .. val(ud.stealth),
+			'"sonarstealth":' .. val(ud.sonarStealth), '"shield":' .. val(shieldPower), '"sight":' .. val(ud.sightDistance),
+			'"radar":' .. val(ud.radarDistance), '"jammer":' .. val(ud.radarDistanceJam), '"mass":' .. val(ud.mass),
+			'"fx":' .. val(ud.xsize), '"fz":' .. val(ud.zsize), '"building":' .. val(ud.isBuilding),
+			'"builder":' .. val(ud.isBuilder), '"buildspeed":' .. val(ud.buildSpeed), '"selfd":' .. val(ud.selfDCountdown),
+			'"autoheal":' .. val(ud.autoHeal), '"idleheal":' .. val(ud.idleAutoHeal),
+			'"weapons":[' .. table.concat(ws, ",") .. ']',
+		}
+		out:write((first and "" or ",\n") .. esc(ud.name) .. ":{" .. table.concat(f, ",") .. "}")
+		first = false
+	end
+	out:write("\n}}\n")
+	out:close()
+	Spring.Echo("[BARAI_DEFS] wrote " .. path)
+	Spring.SendCommands("quitforce")
+end
diff --git a/tools/eco_variance.py b/tools/eco_variance.py
new file mode 100644
index 00000000..72e0bbf4
--- /dev/null
+++ b/tools/eco_variance.py
@@ -0,0 +1,147 @@
+#!/usr/bin/env python3
+"""What sets a seat's economy apart when the code is the same (his 11-22: "some of our games online seem unusually easy.
+It's just a matter of whether it played good eco on that particular game or not. I wish we could identify what causes
+that ECO to perform worse").
+
+    python tools/eco_variance.py <match dir> ... [--ai Apex] [--outcome-min 20]
+
+Every Apex seat of every game (result.json stats, dev_stats) is one row: its metal income at --outcome-min (metal
+produced over the two minutes before it) and its early state at minutes 4/6/8/10/12 -- extractors, builders, metal in
+economy / build power / army / defence / factories, metal lost, reclaimed and wasted (excess), the T2 lab start, the
+commander's idle share. Printed: for each early measure, Spearman's rank correlation with the outcome over all seats,
+and the same within games (each seat against the mean of the game's other Apex seats, which takes the map and the
+opponent out); the strongest first. Then the five best and five worst seats side by side on the strongest measures.
+"""
+import json
+import math
+import sys
+from pathlib import Path
+
+FEATS = ("mex", "ownBuilders", "mEco", "mBP", "mArmy", "mDefence", "mFactories", "mLostReal", "mLostCheap", "mReclaim",
+         "metalExcess", "conT1", "passive", "commIdle")
+MINS = (4, 6, 8, 10, 12)
+
+
+def rank(v):
+    o = sorted(range(len(v)), key=lambda i: v[i])
+    r = [0.0] * len(v)
+    i = 0
+    while i < len(o):
+        j = i
+        while j + 1 < len(o) and v[o[j + 1]] == v[o[i]]:
+            j += 1
+        for k in range(i, j + 1):
+            r[o[k]] = (i + j) / 2.0
+        i = j + 1
+    return r
+
+
+def spearman(x, y):
+    if len(x) < 4:
+        return 0.0
+    rx, ry = rank(x), rank(y)
+    mx, my = sum(rx) / len(rx), sum(ry) / len(ry)
+    sxy = sum((a - mx) * (b - my) for a, b in zip(rx, ry))
+    sx = math.sqrt(sum((a - mx) ** 2 for a in rx))
+    sy = math.sqrt(sum((b - my) ** 2 for b in ry))
+    return sxy / (sx * sy) if sx > 0 and sy > 0 else 0.0
+
+
+def seats(match, ai_prefix, out_min):
+    rj = Path(match) / "result.json"
+    if not rj.exists():
+        return []
+    d = json.loads(rj.read_text())
+    specs = {}
+    for t in (d.get("teams") or []):
+        try:
+            specs[int(t.get("team", -1))] = str(t.get("ai", t.get("spec", "")))
+        except (TypeError, ValueError):
+            pass
+    rows = {}
+    for r in d.get("stats") or []:
+        rows.setdefault(int(r["team"]), []).append(r)
+    out = []
+    for t, rs in rows.items():
+        rs.sort(key=lambda r: r["frame"])
+
+        def at(m):
+            best = None
+            for r in rs:
+                if r["frame"] <= m * 1800 + 1:
+                    best = r
+            return best
+        end, before = at(out_min), at(out_min - 2)
+        if end is None or before is None or end["frame"] < (out_min - 0.5) * 1800:
+            continue
+        dt = (end["frame"] - before["frame"]) / 30.0
+        if dt <= 0:
+            continue
+        inc = (end.get("metalProduced", 0) - before.get("metalProduced", 0)) / dt
+        row = {"match": Path(match).name, "team": t, "ally": int(end.get("ally", -1)), "spec": specs.get(t, ""),
+               "inc": inc}
+        for m in MINS:
+            r = at(m)
+            if r is None:
+                continue
+            for f in FEATS:
+                row["%s@%d" % (f, m)] = float(r.get(f, 0) or 0)
+            ts = float(r.get("techStart", -1) or -1)
+            row["t2start@%d" % m] = 1.0 if 0 < ts <= m * 1800 else 0.0
+            cs = float(r.get("commSamp", 0) or 0)
+            row["commIdleShare@%d" % m] = float(r.get("commIdle", 0) or 0) / cs if cs else 0.0
+        out.append(row)
+    if ai_prefix:
+        out = [r for r in out if not r["spec"] or r["spec"].startswith(ai_prefix)] or out
+    return out
+
+
+def main(a):
+    def opt(name, default):
+        return a[a.index(name) + 1] if name in a else default
+    out_min = int(opt("--outcome-min", "20"))
+    ai = opt("--ai", "")
+    paths = [x for i, x in enumerate(a) if not x.startswith("--") and (i == 0 or a[i - 1] not in ("--ai", "--outcome-min"))]
+    rows = []
+    for p in paths:
+        rows += seats(p, ai, out_min)
+    print("seats %d from %d games; income at %d min: median %.0f, range %.0f-%.0f" % (
+        len(rows), len(paths), out_min, sorted(r["inc"] for r in rows)[len(rows) // 2] if rows else 0,
+        min((r["inc"] for r in rows), default=0), max((r["inc"] for r in rows), default=0)))
+    keys = sorted({k for r in rows for k in r if "@" in k})
+    by_game = {}
+    for r in rows:
+        by_game.setdefault(r["match"], []).append(r)
+    res = []
+    for k in keys:
+        have = [r for r in rows if k in r]
+        x = [r[k] for r in have]
+        y = [r["inc"] for r in have]
+        if len(set(x)) < 3:
+            continue
+        # within games: each seat minus the mean of the game's other seats
+        wx, wy = [], []
+        for g in by_game.values():
+            g = [r for r in g if k in r]
+            if len(g) < 2:
+                continue
+            for r in g:
+                o = [q for q in g if q is not r]
+                wx.append(r[k] - sum(q[k] for q in o) / len(o))
+                wy.append(r["inc"] - sum(q["inc"] for q in o) / len(o))
+        res.append((abs(spearman(wx, wy)), spearman(x, y), spearman(wx, wy), k))
+    res.sort(reverse=True)
+    print("early measure        all seats   within games   (Spearman rho with income at %d)" % out_min)
+    for _, rho, wrho, k in res[:20]:
+        print("  %-20s %+.2f       %+.2f" % (k, rho, wrho))
+    top = [k for _, _, _, k in res[:5]]
+    srt = sorted(rows, key=lambda r: r["inc"])
+    print("\nworst and best seats on the top measures:")
+    print("  %-34s %6s  " % ("game/team", "inc") + "  ".join("%14s" % k for k in top))
+    for r in srt[:5] + srt[-5:]:
+        print("  %-34s %6.0f  " % ((r["match"][:28] + "/t%d" % r["team"]), r["inc"])
+              + "  ".join("%14.0f" % r.get(k, float("nan")) for k in top))
+
+
+if __name__ == "__main__":
+    main(sys.argv[1:])
diff --git a/tools/mp_teams.py b/tools/mp_teams.py
new file mode 100644
index 00000000..52759ec9
--- /dev/null
+++ b/tools/mp_teams.py
@@ -0,0 +1,71 @@
+"""Per team, from a recorded replay (replay_orders.py orders.txt.gz): human or AI, metal killed and lost, the
+trade, and whether its alliance won. For his online games: how our bots did against people.
+
+    python tools/mp_teams.py <replay-orders dir> [...]
+"""
+import gzip
+import sys
+from collections import defaultdict
+from pathlib import Path
+
+
+def read(d):
+    cost, team_ally, is_ai, winners = {}, {}, {}, set()
+    lost, killed, last = defaultdict(float), defaultdict(float), 0
+    with gzip.open(Path(d) / "orders.txt.gz", "rt", errors="replace") as f:
+        for ln in f:
+            t = ln[:2]
+            if t == "D ":
+                p = ln.split()
+                cost[int(p[1])] = float(p[4])
+            elif t == "T ":
+                p = ln.split()
+                team_ally[int(p[1])] = int(p[2])
+                is_ai[int(p[1])] = p[3] == "true"
+            elif t == "K ":
+                p = ln.split()
+                fr, defid, team, ateam = int(p[1]), int(p[3]), int(p[4]), int(p[9])
+                last = max(last, fr)
+                m = cost.get(defid, 0.0)
+                if ateam >= 0 and team_ally.get(ateam) != team_ally.get(team):
+                    lost[team] += m
+                    killed[ateam] += m
+            elif t == "W ":
+                winners.update(int(x) for x in ln.split()[2:])
+    return team_ally, is_ai, lost, killed, winners, last
+
+
+def summary(dirs):
+    """One line a game: AI teams' and humans' summed trade, and whether the alliance holding AI teams won."""
+    for d in dirs:
+        try:
+            ta, ai, lost, killed, win, last = read(d)
+        except (OSError, EOFError):
+            continue
+        if not ta or last < 1800 * 5:
+            continue
+        g = {True: [0.0, 0.0], False: [0.0, 0.0]}
+        for t in ta:
+            g[ai[t]][0] += killed[t]
+            g[ai[t]][1] += lost[t]
+        ai_allies = {ta[t] for t in ta if ai[t]}
+        hum_allies = {ta[t] for t in ta if not ai[t] and (killed[t] or lost[t])}
+        kind = "mixed" if ai_allies & hum_allies else "AI-vs-human"
+        res = "AI side won" if win & ai_allies and not win & hum_allies - ai_allies else (
+            "AI side lost" if win else "?")
+        print("%s %3d min  %-11s AI trade %5.2f  humans %5.2f  %s" % (
+            Path(d).name[:10], last // 1800, kind, g[True][0] / max(g[True][1], 1), g[False][0] / max(g[False][1], 1),
+            res if kind != "mixed" else ""))
+
+
+if __name__ == "__main__":
+    if sys.argv[1] == "--summary":
+        summary(sorted(sys.argv[2:]))
+        sys.exit()
+    for d in sys.argv[1:]:
+        ta, ai, lost, killed, win, last = read(d)
+        print("%s  (%d min, winners ally %s)" % (Path(d).name[:60], last // 1800, sorted(win) or "?"))
+        for t in sorted(ta):
+            print("  t%-2d ally %d %-5s killed %8.0f lost %8.0f trade %5.2f %s" % (
+                t, ta[t], "AI" if ai[t] else "human", killed[t], lost[t], killed[t] / max(lost[t], 1.0),
+                "WON" if ta[t] in win else ""))
diff --git a/tools/public_replays.py b/tools/public_replays.py
new file mode 100644
index 00000000..2dfbf4e0
--- /dev/null
+++ b/tools/public_replays.py
@@ -0,0 +1,276 @@
+#!/usr/bin/env python3
+"""Public replays of strong players, for learning army control (todo/learn-army-from-replays.md).
+
+    python tools/public_replays.py pick [--preset duel|team] [--pages 20] [--min-os 30] [--min-minutes 6] [--max-minutes 60]
+    python tools/public_replays.py fetch [--limit N]          demos, then missing maps and game versions
+    python tools/public_replays.py record [--workers 3] [--limit N]
+    python tools/public_replays.py status
+
+pick pages BAR's replay service (api.bar-rts.com/replays, newest first) and judges each game's detail: no AIs,
+ended normally, no unit tweaks, start metal 1000, length in range, every player's rating (OS) at or above the floor.
+One line per game judged in ROOT/manifest.jsonl (kept or why not); re-running adds new games only.
+
+Everything downloaded lives under ROOT (G:/bar-ai-archive/public-replays): demos/ and a separate engine data
+folder data/ for maps and game versions his install lacks, read beside his install's data by the replay run.
+His install is never written to (fetching a game version there moves the byar:test tag his lobby uses).
+"""
+import glob
+import gzip
+import json
+import os
+import subprocess
+import sys
+import time
+import urllib.parse
+import urllib.request
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import bar_env  # noqa: E402
+
+API = "https://api.bar-rts.com/replays"
+DEMO_URL = "https://storage.uk.cloud.ovh.net/v1/AUTH_10286efc0d334efd917d476d7183232e/BAR/demos/"
+ROOT = Path("G:/bar-ai-archive/public-replays")
+MANIFEST = ROOT / "manifest.jsonl"
+UA = {"User-Agent": "bar-ai replay research"}
+PRD_ENV = {"PRD_RAPID_USE_STREAMER": "false", "PRD_RAPID_REPO_MASTER": "https://repos-cdn.beyondallreason.dev/repos.gz",
+           "PRD_HTTP_SEARCH_URL": "https://files-cdn.beyondallreason.dev/find"}
+
+
+def get(url, tries=4):
+    for i in range(tries):
+        try:
+            with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=90) as r:
+                return json.loads(r.read())
+        except Exception as e:  # the service is slow at times
+            if i == tries - 1:
+                raise
+            time.sleep(5 * (i + 1))
+
+
+LONG_MIN, LONG_OS = 25.0, 20.0
+
+
+def os_of(p):
+    try:
+        return float(str(p.get("skill", "")).strip("[]"))
+    except ValueError:
+        return None
+
+
+def data_dirs():
+    env = bar_env.load()
+    return [env.data, ROOT / "data"]
+
+
+def installed_versions():
+    names = set()
+    for d in data_dirs():
+        packages = {Path(p).stem for p in glob.glob(str(d / "packages" / "*.sdp"))}
+        for path in glob.glob(str(d / "rapid" / "*" / "*" / "versions.gz")):
+            with gzip.open(path, "rt", errors="replace") as f:
+                for line in f:
+                    parts = line.rstrip("\n").split(",")
+                    if len(parts) >= 4 and parts[1] in packages:
+                        names.add(parts[3])
+    return names
+
+
+def installed_maps():
+    out = set()
+    for d in data_dirs():
+        out |= {Path(p).stem.lower() for p in glob.glob(str(d / "maps" / "*.sd[7z]"))}
+    return out
+
+
+def installed_engines():
+    return {Path(p).name.replace("recoil_", "") for p in glob.glob(str(bar_env.load().data / "engine" / "recoil_*"))}
+
+
+def judge(d, min_os, min_minutes, max_minutes):
+    if d.get("hasBots"):
+        return "bots"
+    if not d.get("gameEndedNormally"):
+        return "not ended normally"
+    s = d.get("gameSettings") or {}
+    if s.get("tweakunits") or s.get("tweakdefs"):
+        return "tweaked units"
+    if str(s.get("startmetal", "1000")) != "1000":
+        return "start metal %s" % s.get("startmetal")
+    minutes = (d.get("durationMs") or 0) / 60000
+    if not min_minutes <= minutes <= max_minutes:
+        return "%.1f minutes" % minutes
+    players = [p for a in d.get("AllyTeams") or [] for p in a.get("Players") or []]
+    if not players:
+        return "no players"
+    # long games keep down to OS 20 (11-21: the army model has barely seen the late game; training weights each
+    # player's orders by skill, 0.25 at OS 20 and 1.0 at 35, so weaker players teach less, not nothing)
+    floor = min(min_os, LONG_OS) if minutes > LONG_MIN else min_os
+    low = [p for p in players if os_of(p) is None or os_of(p) < floor]
+    if low and minutes > LONG_MIN and len(players) > 2:
+        # a long team game is judged by its median player (11-21: one weak player of 16 turned away 1,477 long
+        # games; each order is weighted by how its moment went, so a weak player's bad orders teach little)
+        rated = sorted(os_of(p) or 0 for p in players)
+        low = [] if rated[len(rated) // 2] >= floor else low
+    if low:
+        return "OS below %s: %d of %d" % (floor, len(low), len(players))
+    if d.get("engineVersion") not in installed_engines():
+        return "engine %s not installed" % d.get("engineVersion")
+    return None
+
+
+def line_of(d, why):
+    teams = []
+    for a in d.get("AllyTeams") or []:
+        teams.append({"ally": a.get("allyTeamId"), "won": a.get("winningTeam"),
+                      "players": [{"name": p.get("name"), "team": p.get("teamId"), "os": os_of(p),
+                                   "faction": p.get("faction")} for p in a.get("Players") or []]})
+    m = d.get("Map") or {}
+    return {"id": d["id"], "start": d.get("startTime"), "minutes": round((d.get("durationMs") or 0) / 60000, 1),
+            "preset": d.get("preset"), "file": d.get("fileName"), "game": d.get("gameVersion"),
+            "engine": d.get("engineVersion"), "map_script": m.get("scriptName"), "map_file": m.get("fileName"),
+            "ranked": (d.get("gameSettings") or {}).get("ranked_game"), "teams": teams, "keep": why is None,
+            "why": why}
+
+
+def load():
+    if not MANIFEST.exists():
+        return []
+    return [json.loads(l) for l in open(MANIFEST, encoding="utf-8") if l.strip()]
+
+
+def save(rows):
+    tmp = MANIFEST.with_suffix(".tmp")
+    with open(tmp, "w", encoding="utf-8") as f:
+        for r in rows:
+            f.write(json.dumps(r) + "\n")
+    os.replace(tmp, MANIFEST)
+
+
+def pick(preset, pages, min_os, min_minutes, max_minutes):
+    ROOT.mkdir(parents=True, exist_ok=True)
+    rows = load()
+    seen = {r["id"] for r in rows}
+    kept = 0
+    for page in range(1, pages + 1):
+        q = {"page": page, "limit": 50, "preset": preset, "hasBots": "false"}
+        data = get(API + "?" + urllib.parse.urlencode(q)).get("data") or []
+        if not data:
+            break
+        new = 0
+        for row in data:
+            if row["id"] in seen:
+                continue
+            minutes = (row.get("durationMs") or 0) / 60000
+            if not min_minutes <= minutes <= max_minutes:
+                continue
+            d = get(API + "/" + row["id"])
+            ln = line_of(d, judge(d, min_os, min_minutes, max_minutes))
+            rows.append(ln)
+            seen.add(row["id"])
+            kept += ln["keep"]
+            new += 1
+            time.sleep(0.3)
+        save(rows)
+        print("page %d: %d judged, %d kept so far" % (page, new, kept), flush=True)
+    print("manifest %d games, %d kept" % (len(rows), sum(r["keep"] for r in rows)))
+
+
+def prd(args):
+    exe = sorted(glob.glob(str(bar_env.load().data / "engine" / "recoil_*" / "pr-downloader.exe")))[-1]
+    (ROOT / "data").mkdir(parents=True, exist_ok=True)
+    return subprocess.run([exe, "--filesystem-writepath", str(ROOT / "data")] + args,
+                          env={**os.environ, **PRD_ENV}, check=False).returncode
+
+
+def fetch(limit=None):
+    rows = load()
+    kept = [r for r in rows if r["keep"]]
+    (ROOT / "demos").mkdir(parents=True, exist_ok=True)
+    n = 0
+    for r in kept:
+        path = ROOT / "demos" / r["file"]
+        if path.exists() and path.stat().st_size > 0:
+            continue
+        if limit and n >= limit:
+            break
+        url = DEMO_URL + urllib.parse.quote(r["file"])
+        with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=180) as src:
+            data = src.read()
+        path.with_suffix(".part").write_bytes(data)
+        os.replace(path.with_suffix(".part"), path)
+        n += 1
+        time.sleep(0.3)
+    print("%d demos fetched" % n, flush=True)
+    have = installed_maps()
+    for script, fname in sorted({(r["map_script"], r["map_file"]) for r in kept}):
+        if (fname or "").lower() not in have:
+            prd(["--download-map", script])
+    have = installed_versions()
+    for v in sorted({r["game"] for r in kept} - have):
+        if "$VERSION" not in v:
+            prd(["--download-game", v])
+    missing = sorted({r["game"] for r in kept} - installed_versions())
+    print("game versions still missing:", missing or "none")
+
+
+def record(workers=3, limit=None):
+    import replay_orders
+    rows = [r for r in load() if r["keep"] and (ROOT / "demos" / r["file"]).exists()]
+    have = installed_versions()
+    # longest first (11-21: the army model matches our own army to minute 20 and falls apart after; only 4% of the
+    # players' orders came after minute 30)
+    todo = sorted((r for r in rows if r["game"] in have
+                   and not (ROOT / "recordings" / Path(r["file"]).stem / "orders.txt.gz").exists()),
+                  key=lambda r: -(r.get("minutes") or 0))
+    if limit:
+        todo = todo[:limit]
+    replay_orders.batch_list([ROOT / "demos" / r["file"] for r in todo], workers, ROOT / "recordings",
+                             extra_data=ROOT / "data")
+
+
+def status():
+    rows = load()
+    kept = [r for r in rows if r["keep"]]
+    print("judged %d, kept %d" % (len(rows), len(kept)))
+    why = {}
+    for r in rows:
+        if not r["keep"]:
+            k = r["why"].split(":")[0]
+            why[k] = why.get(k, 0) + 1
+    print("turned away:", sorted(why.items(), key=lambda kv: -kv[1])[:8])
+    print("kept by preset:", {p: sum(r["preset"] == p for r in kept) for p in {r["preset"] for r in kept}})
+    print("demos on disk:", sum((ROOT / "demos" / r["file"]).exists() for r in kept))
+    print("recorded:", sum((ROOT / "recordings" / Path(r["file"]).stem / "orders.txt.gz").exists() for r in kept))
+
+
+def main(a):
+    def opt(name, default):
+        return a[a.index(name) + 1] if name in a else default
+    if a[:1] == ["pick"]:
+        pick(opt("--preset", "duel"), int(opt("--pages", "20")), float(opt("--min-os", "30")),
+             float(opt("--min-minutes", "6")), float(opt("--max-minutes", "60")))
+    elif a[:1] == ["fetch"]:
+        fetch(int(opt("--limit", "0")) or None)
+    elif a[:1] == ["record"]:
+        record(int(opt("--workers", "3")), int(opt("--limit", "0")) or None)
+    elif a[:1] == ["follow"]:
+        idle = 0
+        while idle < 3:
+            before = sum(1 for r in load() if r["keep"])
+            fetch()
+            record(int(opt("--workers", "3")), 60)
+            done = sum((ROOT / "recordings" / Path(r["file"]).stem / "orders.txt.gz").exists() for r in load() if r["keep"])
+            idle = idle + 1 if done >= sum(1 for r in load() if r["keep"]) and before == sum(1 for r in load() if r["keep"]) else 0
+            if idle:
+                time.sleep(600)
+    elif a[:1] == ["status"]:
+        status()
+    else:
+        print(__doc__)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
