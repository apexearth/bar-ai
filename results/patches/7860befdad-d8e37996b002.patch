@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""The shape of human group orders in an orders.txt (tools/replay_orders.py).
+
+    python tools/replay_orders_shapes.py <orders.txt>
+
+A group order: one human team, one frame, one move/fight order, 5+ army/air units. Its targets'
+spread along their main axis (length) and across it (width): a line is long and thin, a point
+order has every target in one spot. The line's facing is compared with the direction to the
+nearest enemy mass (5 s position samples): a line held against them stands across that direction.
+"""
+import collections
+import math
+import sys
+
+FOCUS = {"army", "air", "radar", "jammer"}
+
+
+def main(path):
+    defs, teams, groups, samples = {}, {}, collections.defaultdict(list), collections.defaultdict(list)
+    for ln in open(path, encoding="utf-8", errors="replace"):
+        p = ln.split()
+        if not p:
+            continue
+        if p[0] == "D":
+            defs[int(p[1])] = p[3]
+        elif p[0] == "T":
+            teams[int(p[1])] = (int(p[2]), p[3] == "true")
+        elif p[0] == "C" and len(p) > 9 and int(p[5]) in (10, 16):
+            t = int(p[2])
+            if teams.get(t, (0, True))[1] or defs.get(int(p[4])) not in FOCUS:
+                continue
+            ps = [float(v) for v in p[-1].split(",")]
+            if len(ps) >= 3:
+                groups[(int(p[1]), t)].append((float(p[7]), float(p[8]), ps[0], ps[2]))
+        elif p[0] == "P":
+            samples[int(p[1])].append((int(p[2]), defs.get(int(p[4])), float(p[5]), float(p[6])))
+    frames = sorted(samples)
+    kinds = collections.Counter()
+    angles = []
+    for (f, t), rows in groups.items():
+        if len(rows) < 5:
+            continue
+        tx = [r[2] for r in rows]
+        tz = [r[3] for r in rows]
+        mx, mz = sum(tx) / len(tx), sum(tz) / len(tz)
+        sxx = sum((x - mx) ** 2 for x in tx) / len(tx)
+        szz = sum((z - mz) ** 2 for z in tz) / len(tz)
+        sxz = sum((x - mx) * (z - mz) for x, z in zip(tx, tz)) / len(tx)
+        tr, det = sxx + szz, sxx * szz - sxz ** 2
+        l1 = tr / 2 + math.sqrt(max(tr * tr / 4 - det, 0))
+        l2 = max(tr - l1, 0)
+        length, width = 2 * math.sqrt(l1), 2 * math.sqrt(l2)
+        if length < 40:
+            kinds["point (all to one spot)"] += 1
+            continue
+        kinds["line (long/wide > 3)" if length > 3 * max(width, 1) else "blob (2-D spread)"] += 1
+        if length <= 3 * max(width, 1):
+            continue
+        ax = math.atan2(2 * sxz, sxx - szz) / 2
+        near = min(frames, key=lambda g: abs(g - f)) if frames else None
+        ally = teams[t][0]
+        foes = [(x, z) for tm, c, x, z in samples.get(near, []) if c in FOCUS and teams.get(tm, (ally,))[0] != ally
+                and teams.get(tm, (ally,))[0] >= 0]
+        if not foes:
+            continue
+        foes.sort(key=lambda q: (q[0] - mx) ** 2 + (q[1] - mz) ** 2)
+        fx = sum(q[0] for q in foes[:10]) / len(foes[:10])
+        fz = sum(q[1] for q in foes[:10]) / len(foes[:10])
+        to_foe = math.atan2(fz - mz, fx - mx)
+        d = abs((to_foe - ax + math.pi / 2) % math.pi - math.pi / 2)
+        angles.append((math.degrees(d), math.hypot(fx - mx, fz - mz), length))
+    total = sum(kinds.values())
+    print("human group orders (5+ units, one frame):", total)
+    for k, n in kinds.most_common():
+        print("  %-26s %5d  %.0f%%" % (k, n, 100 * n / max(total, 1)))
+    if angles:
+        across = [a for a in angles if a[0] >= 60]
+        print("lines with an enemy mass in sight: %d; standing across the direction to it (60-90 deg): %d (%.0f%%)"
+              % (len(angles), len(across), 100 * len(across) / len(angles)))
+        L = sorted(a[2] for a in angles)
+        D = sorted(a[1] for a in angles)
+        print("  line length median %.0f elmos; distance to the enemy mass median %.0f" % (L[len(L) // 2], D[len(D) // 2]))
+
+
+if __name__ == "__main__":
+    main(sys.argv[1])
diff --git a/tools/replay_orders_stats.py b/tools/replay_orders_stats.py
new file mode 100644
index 00000000..46c0e95b
--- /dev/null
+++ b/tools/replay_orders_stats.py
@@ -0,0 +1,81 @@
+import collections
+import statistics
+import sys
+
+CMD = {0: "stop", 1: "insert", 2: "remove", 5: "wait", 10: "move", 15: "patrol", 16: "fight", 20: "attack",
+       21: "area_attack", 25: "guard", 40: "repair", 45: "firestate", 50: "movestate", 70: "wantedspeed",
+       75: "load", 81: "unload", 85: "onoff", 90: "reclaim", 95: "cloak", 110: "restore", 115: "repeat",
+       125: "resurrect", 130: "capture", 140: "autorepair", 145: "idlemode"}
+
+defs, teams, cmds, pos = {}, {}, [], []
+for ln in open(sys.argv[1], encoding="utf-8", errors="replace"):
+    p = ln.split()
+    if not p:
+        continue
+    if p[0] == "D":
+        defs[int(p[1])] = (p[2], p[3], float(p[4]))
+    elif p[0] == "T":
+        teams[int(p[1])] = (int(p[2]), p[3] == "true")
+    elif p[0] == "C":
+        cmds.append((int(p[1]), int(p[2]), int(p[3]), int(p[4]), int(p[5]), p[6] if len(p) > 9 else "",
+                     p[-1] if len(p) > 9 else ""))
+    elif p[0] == "P":
+        pos.append((int(p[1]), int(p[2]), int(p[3]), int(p[4])))
+
+FOCUS = {"army", "radar", "jammer", "air"}
+human = {t for t, (a, ai) in teams.items() if not ai and a >= 0}
+ai = {t for t, (a, ai) in teams.items() if ai}
+print("teams", len(teams), "human", sorted(human), "ai", sorted(ai))
+
+
+def side(t):
+    return "human" if t in human else "ai" if t in ai else "other"
+
+
+def name(c):
+    return CMD.get(c, "build" if c < 0 else str(c))
+
+
+by = collections.Counter((side(t), defs.get(d, ("?", "?"))[1]) for f, t, u, d, c, o, ps in cmds)
+print("\norders by side and unit class")
+for k, n in sorted(by.items(), key=lambda kv: -kv[1]):
+    print("  %-6s %-8s %7d" % (k[0], k[1], n))
+
+for s in ("human", "ai"):
+    sel = [x for x in cmds if side(x[1]) == s and defs.get(x[3], ("", ""))[1] in FOCUS]
+    print("\n== %s, focus classes (army/air/radar/jammer): %d orders" % (s, len(sel)))
+    print("  types", collections.Counter(name(x[4]) for x in sel).most_common(12))
+    print("  modifiers", collections.Counter(x[5] for x in sel).most_common(6))
+    grp = collections.Counter((x[0], x[1], x[4]) for x in sel)
+    sizes = list(grp.values())
+    if sizes:
+        print("  issue events %d, units per event median %s, mean %.1f, share of orders in events of 5+ %.2f" % (
+            len(sizes), statistics.median(sizes), statistics.mean(sizes),
+            sum(n for n in sizes if n >= 5) / sum(sizes)))
+    # positional orders only (move/fight/attack/patrol): gap between successive orders to a unit
+    last, gaps = {}, []
+    for f, t, u, d, c, o, ps in sel:
+        if c in (10, 15, 16, 20, 21):
+            if u in last and f - last[u] > 0:
+                gaps.append((f - last[u]) / 30)
+            last[u] = f
+    if gaps:
+        q = statistics.quantiles(gaps, n=4)
+        print("  seconds between move/fight/attack/patrol orders to one unit: q1 %.1f median %.1f q3 %.1f (n=%d)" % (
+            q[0], q[1], q[2], len(gaps)))
+    # how many focus units alive per sample vs how many got a positional order in the next 30 s
+    alive = collections.defaultdict(set)
+    for f, t, u, d in pos:
+        if side(t) == s and defs.get(d, ("", ""))[1] in FOCUS:
+            alive[f].add(u)
+    ordered = collections.defaultdict(set)
+    for f, t, u, d, c, o, ps in sel:
+        if c in (10, 15, 16, 20, 21):
+            ordered[f // 900].add(u)
+    rows = []
+    for f in sorted(alive):
+        if f % 900 == 0 and f > 0:
+            a = alive[f]
+            rows.append((f // 1800, len(a), len(a & ordered[f // 900])))
+    print("  per 30 s window: (minute, focus units alive, of them given a positional order in the window)")
+    print("  ", rows[::2])
diff --git a/tools/replay_orders_widget.lua b/tools/replay_orders_widget.lua
new file mode 100644
index 00000000..efad9db0
--- /dev/null
+++ b/tools/replay_orders_widget.lua
@@ -0,0 +1,210 @@
+function widget:GetInfo()
+	return { name = "BARAI order capture", desc = "orders, per-allyteam sight, deaths and damage, from a replay",
+		author = "bar-ai", layer = 0, enabled = true }
+end
+
+local out, maxFrame
+local classOf, mobileDef = {}, {}
+local allies = {}
+local dmg = {}
+local GetUnitLosState = Spring.GetUnitLosState
+
+local function cls(ud)
+	if ud.customParams and ud.customParams.iscommander then return "com" end
+	local mobile = (ud.speed or 0) > 0 and not ud.isBuilding
+	if not mobile then return "static" end
+	if ud.isBuilder or (ud.buildSpeed or 0) > 0 then return "builder" end
+	if (ud.radarDistanceJam or ud.jammerRadius or 0) > 0 then return "jammer" end
+	if (ud.radarDistance or ud.radarRadius or 0) > 0 and #(ud.weapons or {}) == 0 then return "radar" end
+	if ud.canFly then return "air" end
+	if #(ud.weapons or {}) > 0 then return "army" end
+	return "other"
+end
+
+local function weaponStats(ud)
+	local range, dps, aa, ground = 0, 0, 0, 0
+	for _, w in ipairs(ud.weapons or {}) do
+		local wd = WeaponDefs[w.weaponDef]
+		if wd then
+			local d = 0
+			pcall(function() d = (wd.damages and (wd.damages[0] or wd.damages.default)) or 0 end)
+			local per = d * (wd.salvoSize or 1) * (wd.projectiles or 1) / math.max(wd.reload or 1, 0.03)
+			local only = w.onlyTargets or {}
+			local aaOnly = only.vtol and not only.notair and not only.surface and not only.ground
+			if aaOnly then
+				aa = aa + per
+			else
+				ground = ground + per
+				range = math.max(range, wd.range or 0)
+			end
+			dps = dps + per
+		end
+	end
+	return range, ground, aa
+end
+
+function widget:Initialize()
+	if not Spring.IsReplay() then
+		widgetHandler:RemoveWidget(self)
+		return
+	end
+	local f = io.open("LuaUI/Config/orders_maxframe.txt", "r")
+	maxFrame = f and tonumber(f:read("*l")) or 1e9
+	if f then f:close() end
+	out = io.open("LuaUI/Config/orders.txt", "w")
+	out:write(string.format("V 2 %d %d\n", Game.mapSizeX, Game.mapSizeZ))
+	for id, ud in pairs(UnitDefs) do
+		classOf[id] = cls(ud)
+		mobileDef[id] = classOf[id] ~= "static"
+		local r, g, a = weaponStats(ud)
+		out:write(string.format("D %d %s %s %.0f %.0f %.1f %.0f %.1f %.1f %.0f %.0f %.0f\n", id, ud.name, classOf[id],
+			ud.metalCost or 0, ud.health or 0, ud.speed or 0, r, g, a, ud.sightDistance or ud.losRadius or 0,
+			ud.radarDistance or ud.radarRadius or 0, ud.radarDistanceJam or ud.jammerRadius or 0))
+	end
+	for _, a in ipairs(Spring.GetAllyTeamList()) do
+		if a ~= select(6, Spring.GetTeamInfo(Spring.GetGaiaTeamID())) then allies[#allies + 1] = a end
+	end
+	out:write("A " .. table.concat(allies, " ") .. "\n")
+	for _, t in ipairs(Spring.GetTeamList()) do
+		local _, _, _, isAI, _, ally = Spring.GetTeamInfo(t)
+		out:write(string.format("T %d %d %s\n", t, ally or -1, tostring(isAI)))
+	end
+	local n = Spring.GetGameRulesParam("mex_count") or 0
+	for i = 1, n do
+		out:write(string.format("S %d %.0f %.0f\n", i, Spring.GetGameRulesParam("mex_x" .. i) or -1,
+			Spring.GetGameRulesParam("mex_z" .. i) or -1))
+	end
+	local step = 64
+	local hs = {}
+	for z = step / 2, Game.mapSizeZ, step do
+		for x = step / 2, Game.mapSizeX, step do
+			hs[#hs + 1] = string.format("%.0f", Spring.GetGroundHeight(x, z))
+		end
+	end
+	out:write("H " .. step .. " " .. table.concat(hs, " ") .. "\n")
+	Spring.SendCommands({ "specfullview 1", "setmaxspeed 1000", "setminspeed 1000" })
+end
+
+local function optStr(o)
+	if type(o) ~= "table" then return tostring(o) end
+	return (o.shift and "s" or "") .. (o.ctrl and "c" or "") .. (o.alt and "a" or "") .. (o.meta and "m" or "") .. (o.right and "r" or "")
+end
+
+local function params(ps)
+	local s = {}
+	for i = 1, math.min(#ps, 4) do s[i] = string.format("%.0f", ps[i]) end
+	return table.concat(s, ",")
+end
+
+function widget:UnitCommand(unitID, unitDefID, unitTeam, cmdID, cmdParams, cmdOpts, cmdTag)
+	if not out then return end
+	local x, _, z = Spring.GetUnitPosition(unitID)
+	out:write(string.format("C %d %d %d %d %d %s %.0f %.0f %s\n", Spring.GetGameFrame(), unitTeam, unitID,
+		unitDefID or -1, cmdID, optStr(cmdOpts), x or -1, z or -1, params(cmdParams)))
+end
+
+function widget:UnitDestroyed(unitID, unitDefID, unitTeam, attackerID, attackerDefID, attackerTeam)
+	if not out then return end
+	local x, _, z = Spring.GetUnitPosition(unitID)
+	out:write(string.format("K %d %d %d %d %.0f %.0f %d %d %d\n", Spring.GetGameFrame(), unitID, unitDefID or -1,
+		unitTeam or -1, x or -1, z or -1, attackerID or -1, attackerDefID or -1, attackerTeam or -1))
+end
+
+function widget:UnitFinished(unitID, unitDefID, unitTeam)
+	if not out then return end
+	local x, _, z = Spring.GetUnitPosition(unitID)
+	out:write(string.format("F %d %d %d %d %.0f %.0f\n", Spring.GetGameFrame(), unitID, unitDefID or -1, unitTeam, x or -1, z or -1))
+end
+
+function widget:UnitGiven(unitID, unitDefID, newTeam, oldTeam)
+	if not out then return end
+	out:write(string.format("G %d %d %d %d\n", Spring.GetGameFrame(), unitID, newTeam, oldTeam))
+end
+
+-- BAR's handler passes widgets no attacker (and refuses user widgets the handler); the engine's
+-- last-attacker record names it. -1 when absent: tools/replay_dataset.py shares that among the enemies in reach.
+local GetUnitLastAttacker = Spring.GetUnitLastAttacker
+function widget:UnitDamaged(unitID, unitDefID, unitTeam, damage, paralyzer)
+	if not out or paralyzer or not damage or damage <= 0 then return end
+	local a = (GetUnitLastAttacker and GetUnitLastAttacker(unitID)) or -1
+	-- by attacker, then victim: one number (a * 2^20 + victim) lost the victim's low digits in Lua's floats once
+	-- attackers were known (11-19: victims read 2048, 3072, 768 ...)
+	local row = dmg[a]
+	if not row then row = {} dmg[a] = row end
+	row[unitID] = (row[unitID] or 0) + damage
+end
+
+local function sightMask(uid)
+	local m = 0
+	for i, a in ipairs(allies) do
+		local raw = GetUnitLosState(uid, a, true) or 0
+		m = m + (raw % 4) * (4 ^ (i - 1))
+	end
+	return m
+end
+
+local function sample(frame, statics)
+	for _, uid in ipairs(Spring.GetAllUnits()) do
+		local d = Spring.GetUnitDefID(uid)
+		if d and (mobileDef[d] or statics) then
+			local x, _, z = Spring.GetUnitPosition(uid)
+			local vx, _, vz = Spring.GetUnitVelocity(uid)
+			local h, mh, _, _, bp = Spring.GetUnitHealth(uid)
+			local c, tx, tz = -1, -1, -1
+			if mobileDef[d] then
+				local q = Spring.GetUnitCommands(uid, 1)
+				if q and q[1] then
+					c = q[1].id
+					local p = q[1].params or {}
+					if #p >= 3 then
+						tx, tz = p[1], p[3]
+					elseif #p == 1 then
+						local ux, _, uz = Spring.GetUnitPosition(p[1])
+						tx, tz = ux or -1, uz or -1
+					end
+				end
+			end
+			out:write(string.format("U %d %d %d %d %.0f %.0f %.1f %.1f %.2f %.2f %d %d %.0f %.0f\n", frame, uid, d,
+				Spring.GetUnitTeam(uid), x or -1, z or -1, (vx or 0) * 30, (vz or 0) * 30, (h or 0) / math.max(mh or 1, 1),
+				bp or 1, sightMask(uid), c, tx, tz))
+		end
+	end
+end
+
+local nextSpeed = 300
+function widget:GameFrame(frame)
+	if not out then return end
+	-- every 10 frames (his 11-19: decisions under 500 ms; players re-order a unit in a fight every 0.23 s median)
+	if frame % 10 == 0 then
+		for a, row in pairs(dmg) do
+			for v, amount in pairs(row) do
+				out:write(string.format("X %d %d %d %.0f\n", frame, a, v, amount))
+			end
+		end
+		dmg = {}
+		sample(frame, frame % 300 == 0)
+	end
+	if frame >= nextSpeed then
+		nextSpeed = frame + 300
+		Spring.SendCommands({ "setmaxspeed 1000", "setminspeed 1000" })
+		out:flush()
+	end
+	if frame >= maxFrame then
+		out:close()
+		out = nil
+		Spring.SendCommands("quitforce")
+	end
+end
+
+function widget:GameOver(winners)
+	if out then
+		out:write(string.format("W %d %s\n", Spring.GetGameFrame(), table.concat(winners or {}, ",")))
+		out:close()
+		out = nil
+	end
+	Spring.SendCommands("quitforce")
+end
+
+function widget:Shutdown()
+	if out then out:close() out = nil end
+end
