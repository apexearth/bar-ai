+	CCircuitAI* circuit = task->GetManager()->GetCircuit();
+	if (!static_cast<IFighterTask*>(task)->IsStockTask()) {
+		return false;
+	}
+	circuit->NoteStockLeak(kind);
+	return true;
+}
