+-- dev_armynet.lua -- let the army model (tools/armynet/serve.py) fight for our side in a local game.
+--
+-- Inert unless the start script sets dev_armynet=1 (run_match.py --modoption dev_armynet=1). On the ally
+-- dev_armynet_ally (default 0), each finished army/air/radar/jammer unit of an Apex team is marked
+-- disableAiControl, and barai_handsoff is set, so our AI drops it from its own control (CCircuitAI::Update)
+-- while still owning and counting it: our AI keeps the economy and production, the model the army.
+-- Every game second the unsynced half writes the side's view to armynet_state.txt in the write dir (the replay
+-- recorder's line format, tools/replay_orders.py); serve.py answers in armynet_orders.txt, which this
+-- half reads and passes to the synced half, which orders marked units only. Local games only.
+
+function gadget:GetInfo()
+	return { name = "BARAI armynet bridge", desc = "the army model fights for our side (dev)", author = "bar-ai",
+		date = "2026-11-18", license = "GNU GPL, v2 or later", layer = 0, enabled = true }
+end
+
+local mo = Spring.GetModOptions and Spring.GetModOptions() or {}
+if mo.dev_armynet ~= "1" then
+	return
+end
+local ALLY = tonumber(mo.dev_armynet_ally or "0") or 0
+-- unit types our AI keeps (dev_armynet_keep, its own scout role list): it scouts with them (11-20)
+local KEEP = {}
+for name in (mo.dev_armynet_keep or ""):gmatch("[^,]+") do KEEP[name] = true end
+
+local function isFocus(ud)
+	if not ud or ud.isBuilding or (ud.speed or 0) <= 0 then return false end
+	if KEEP[ud.name] then return false end
+	if ud.customParams and ud.customParams.iscommander then return false end
+	if ud.isBuilder or (ud.buildSpeed or 0) > 0 then return false end
+	if #(ud.weapons or {}) > 0 then return true end
+	return (ud.radarDistance or ud.radarRadius or 0) > 0 or (ud.radarDistanceJam or ud.jammerRadius or 0) > 0
+end
+
+local function holders()
+	-- the Apex teams on ALLY; each is its own holder (the pairs format is kept: team,team)
+	local map = {}
+	for _, t in ipairs(Spring.GetTeamList()) do
+		local _, _, _, isAI, _, ally = Spring.GetTeamInfo(t)
+		if isAI and ally == ALLY then
+			local _, _, _, short = Spring.GetAIInfo(t)
+			if (short or ""):sub(1, 4) == "Apex" then map[t] = t end
+		end
+	end
+	return map
+end
+
+if gadgetHandler:IsSyncedCode() then
+	local controlled = {}
+	local marked, applied = 0, 0
+
+	local function mark(uid)
+		if Spring.GetUnitRulesParam(uid, "disableAiControl") ~= 1 then
+			Spring.SetUnitRulesParam(uid, "disableAiControl", 1)
+			marked = marked + 1
+		end
+	end
+
+	-- synced code cannot read AI names (GetAIInfo hides them here); the unsynced half sends the teams
+	local function setPairs(body)
+		for a in body:gmatch("(%d+),%d+") do
+			local t = tonumber(a)
+			if not controlled[t] then
+				controlled[t] = true
+				for _, uid in ipairs(Spring.GetTeamUnits(t)) do
+					local _, _, _, _, bp = Spring.GetUnitHealth(uid)
+					if (bp or 0) >= 1 and isFocus(UnitDefs[Spring.GetUnitDefID(uid)]) then mark(uid) end
+				end
+				Spring.Echo("[BARAI_ARMYNET] model commands team " .. t)
+			end
+		end
+	end
+
+	function gadget:Initialize()
+		Spring.SetGameRulesParam("barai_handsoff", 1)
+	end
+
+	function gadget:UnitFinished(unitID, unitDefID, unitTeam)
+		if controlled[unitTeam] and isFocus(UnitDefs[unitDefID]) then mark(unitID) end
+	end
+
+	function gadget:UnitGiven(unitID, unitDefID, newTeam)
+		if controlled[newTeam] and isFocus(UnitDefs[unitDefID]) then mark(unitID) end
+	end
+
+	-- hits on our side's units over the second, attacker included (a gadget is told it; a widget is not), for the
+	-- model's incoming-fire layers (tools/armynet/data.py _fire_layers; the recorder's X lines in replays)
+	local hits = {}
+	local ourAlly = {}
+	function gadget:UnitDamaged(unitID, unitDefID, unitTeam, damage, paralyzer, weaponDefID, projectileID, attackerID)
+		if paralyzer or not damage or damage <= 0 then return end
+		if ourAlly[unitTeam] == nil then
+			local _, _, _, _, _, ally = Spring.GetTeamInfo(unitTeam)
+			ourAlly[unitTeam] = (ally == ALLY)
+		end
+		if not ourAlly[unitTeam] then return end
+		-- by attacker, then victim (one packed number loses the victim's low digits in Lua's floats)
+		local a = attackerID or -1
+		local row = hits[a]
+		if not row then row = {} hits[a] = row end
+		row[unitID] = (row[unitID] or 0) + damage
+	end
+
+	local function flushHits(f)
+		local parts = {}
+		for a, row in pairs(hits) do
+			for v, amount in pairs(row) do
+				parts[#parts + 1] = string.format("%d,%d,%.0f", a, v, amount)
+			end
+		end
+		hits = {}
+		SendToUnsynced("armynetHits", f, table.concat(parts, ";"))
+	end
+
+	function gadget:GameFrame(f)
+		if f % 10 == 9 then flushHits(f + 1) end
+		if f % 1800 == 0 and f > 0 then
+			Spring.Echo(string.format("[BARAI_ARMYNET] minute %d units marked %d orders applied %d", f / 1800, marked, applied))
+		end
+	end
+
+	-- "armynet:uid,cmd,x,z;uid,20,target;..."
+	function gadget:RecvLuaMsg(msg, playerID)
+		if msg:sub(1, 13) == "armynetpairs:" then
+			setPairs(msg:sub(14))
+			return true
+		end
+		if msg:sub(1, 8) ~= "armynet:" then return end
+		for item in msg:sub(9):gmatch("[^;]+") do
+			local f = {}
+			for v in item:gmatch("[^,]+") do f[#f + 1] = tonumber(v) end
+			local uid, cmd = f[1], f[2]
+			if uid and cmd and Spring.ValidUnitID(uid) and controlled[Spring.GetUnitTeam(uid)]
+				and Spring.GetUnitRulesParam(uid, "disableAiControl") == 1 then
+				applied = applied + 1
+				if cmd == CMD.STOP then
+					Spring.GiveOrderToUnit(uid, CMD.STOP, {}, 0)
+				elseif cmd == CMD.ATTACK and #f == 3 then
+					if Spring.ValidUnitID(f[3]) then Spring.GiveOrderToUnit(uid, CMD.ATTACK, { f[3] }, 0) end
+				elseif #f >= 4 then
+					local x, z = f[3], f[4]
+					Spring.GiveOrderToUnit(uid, cmd, { x, Spring.GetGroundHeight(x, z), z }, 0)
+				end
+			end
+		end
+		return true
+	end
+else
+	local STATE, ORDERS, STATIC = "armynet_state.txt", "armynet_orders.txt", "armynet_static.txt"
+	local classOf, allies, holderList = {}, {}, {}
+	local lastOrders = -1
+
+	local function cls(ud)
+		if ud.customParams and ud.customParams.iscommander then return "com" end
+		if (ud.speed or 0) <= 0 or ud.isBuilding then return "static" end
+		if ud.isBuilder or (ud.buildSpeed or 0) > 0 then return "builder" end
+		if (ud.radarDistanceJam or ud.jammerRadius or 0) > 0 then return "jammer" end
+		if (ud.radarDistance or ud.radarRadius or 0) > 0 and #(ud.weapons or {}) == 0 then return "radar" end
+		if ud.canFly then return "air" end
+		if #(ud.weapons or {}) > 0 then return "army" end
+		return "other"
+	end
+
+	local function weaponStats(ud)
+		local range, ground, aa = 0, 0, 0
+		for _, w in ipairs(ud.weapons or {}) do
+			local wd = WeaponDefs[w.weaponDef]
+			if wd then
+				local d = 0
+				pcall(function() d = (wd.damages and (wd.damages[0] or wd.damages.default)) or 0 end)
+				local per = d * (wd.salvoSize or 1) * (wd.projectiles or 1) / math.max(wd.reload or 1, 0.03)
+				local only = w.onlyTargets or {}
+				if only.vtol and not only.notair and not only.surface and not only.ground then
+					aa = aa + per
+				else
+					ground = ground + per
+					range = math.max(range, wd.range or 0)
+				end
+			end
+		end
+		return range, ground, aa
+	end
+
+	local lastHits = {}
+	local function onHits(_, f, body)
+		lastHits = { frame = f, body = body }
+	end
+
+	function gadget:Initialize()
+		gadgetHandler:AddSyncAction("armynetHits", onHits)
+		local m = holders()
+		local seen = {}
+		for src, h in pairs(m) do
+			if not seen[h] then holderList[#holderList + 1] = { h, src } seen[h] = true end
+		end
+		local fh = io.open(STATIC, "w")
+		if not fh then
+			Spring.Echo("[BARAI_ARMYNET] cannot write " .. STATIC)
+			return
+		end
+		fh:write(string.format("V 2 %d %d\n", Game.mapSizeX, Game.mapSizeZ))
+		for id, ud in pairs(UnitDefs) do
+			classOf[id] = cls(ud)
+			local r, g, a = weaponStats(ud)
+			fh:write(string.format("D %d %s %s %.0f %.0f %.1f %.0f %.1f %.1f %.0f %.0f %.0f\n", id, ud.name, classOf[id],
+				ud.metalCost or 0, ud.health or 0, ud.speed or 0, r, g, a, ud.sightDistance or ud.losRadius or 0,
+				ud.radarDistance or ud.radarRadius or 0, ud.radarDistanceJam or ud.jammerRadius or 0))
+		end
+		local gaiaAlly = select(6, Spring.GetTeamInfo(Spring.GetGaiaTeamID()))
+		for _, a in ipairs(Spring.GetAllyTeamList()) do
+			if a ~= gaiaAlly then allies[#allies + 1] = a end
+		end
+		fh:write("A " .. table.concat(allies, " ") .. "\n")
+		for _, t in ipairs(Spring.GetTeamList()) do
+			local _, _, _, isAI, _, ally = Spring.GetTeamInfo(t)
+			fh:write(string.format("T %d %d %s\n", t, ally or -1, tostring(isAI)))
+		end
+		for _, hs in ipairs(holderList) do fh:write(string.format("Q %d %d\n", hs[1], hs[2])) end
+		local n = Spring.GetGameRulesParam("mex_count") or 0
+		for i = 1, n do
+			fh:write(string.format("S %d %.0f %.0f\n", i, Spring.GetGameRulesParam("mex_x" .. i) or -1,
+				Spring.GetGameRulesParam("mex_z" .. i) or -1))
+		end
+		local step, hs = 64, {}
+		for z = step / 2, Game.mapSizeZ, step do
+			for x = step / 2, Game.mapSizeX, step do
+				hs[#hs + 1] = string.format("%.0f", Spring.GetGroundHeight(x, z))
+			end
+		end
+		fh:write("H " .. step .. " " .. table.concat(hs, " ") .. "\n")
+		fh:close()
+		Spring.Echo("[BARAI_ARMYNET] bridge on, holders " .. #holderList)
+	end
+
+	local function sightMask(uid)
+		local m = 0
+		for i, a in ipairs(allies) do
+			local raw = Spring.GetUnitLosState(uid, a, true) or 0
+			m = m + (raw % 4) * (4 ^ (i - 1))
+		end
+		return m
+	end
+
+	local function writeState(frame)
+		local out = {}
+		out[#out + 1] = "F " .. frame
+		for _, uid in ipairs(Spring.GetAllUnits()) do
+			local d = Spring.GetUnitDefID(uid)
+			if d then
+				local x, _, z = Spring.GetUnitPosition(uid)
+				local vx, _, vz = Spring.GetUnitVelocity(uid)
+				local h, mh, _, _, bp = Spring.GetUnitHealth(uid)
+				local c, tx, tz = -1, -1, -1
+				if classOf[d] ~= "static" then
+					local q = Spring.GetUnitCommands(uid, 1)
+					if q and q[1] then
+						c = q[1].id
+						local p = q[1].params or {}
+						if #p >= 3 then tx, tz = p[1], p[3]
+						elseif #p == 1 then
+							local ux, _, uz = Spring.GetUnitPosition(p[1])
+							tx, tz = ux or -1, uz or -1
+						end
+					end
+				end
+				out[#out + 1] = string.format("U %d %d %d %d %.0f %.0f %.1f %.1f %.2f %.2f %d %d %.0f %.0f", frame, uid, d,
+					Spring.GetUnitTeam(uid), x or -1, z or -1, (vx or 0) * 30, (vz or 0) * 30,
+					(h or 0) / math.max(mh or 1, 1), bp or 1, sightMask(uid), c, tx, tz)
+			end
+		end
+		-- the last second's hits on our side, "X frame attacker victim damage" as the replay recorder writes them
+		for item in (lastHits.body or ""):gmatch("[^;]+") do
+			local a, v, dmg = item:match("(-?%d+),(%d+),([%d.]+)")
+			if a then out[#out + 1] = string.format("X %d %s %s %s", lastHits.frame or frame, a, v, dmg) end
+		end
+		out[#out + 1] = "E " .. frame
+		local fh = io.open(STATE, "w")
+		if fh then
+			fh:write(table.concat(out, "\n") .. "\n")
+			fh:close()
+		end
+	end
+
+	local function readOrders()
+		local fh = io.open(ORDERS, "r")
+		if not fh then return end
+		local head = fh:read("*l")
+		local frame = head and tonumber(head:match("^O (%d+)"))
+		if not frame or frame <= lastOrders then
+			fh:close()
+			return
+		end
+		local body = fh:read("*a") or ""
+		fh:close()
+		if not body:find("\nE\n") and body:sub(-2) ~= "E\n" then return end
+		lastOrders = frame
+		local batch, n = {}, 0
+		for ln in body:gmatch("[^\n]+") do
+			if ln ~= "E" then
+				batch[#batch + 1] = ln
+				n = n + 1
+				if #batch >= 40 then
+					Spring.SendLuaRulesMsg("armynet:" .. table.concat(batch, ";"))
+					batch = {}
+				end
+			end
+		end
+		if #batch > 0 then Spring.SendLuaRulesMsg("armynet:" .. table.concat(batch, ";")) end
+		if frame % 900 == 0 or n > 0 and frame % 300 == 0 then
+			Spring.Echo(string.format("[BARAI_ARMYNET] frame %d orders %d", frame, n))
+		end
+	end
+
+	function gadget:GameFrame(frame)
+		if #holderList == 0 then return end
+		if frame < 300 and frame % 30 == 1 then
+			local p = {}
+			for _, hs in ipairs(holderList) do p[#p + 1] = hs[2] .. "," .. hs[1] end
+			Spring.SendLuaRulesMsg("armynetpairs:" .. table.concat(p, ";"))
+		end
+		if frame % 10 == 0 then writeState(frame) end  -- every 10 frames (his 11-19: decisions under 500 ms)
+		if frame % 10 == 5 then readOrders() end
+	end
+end
diff --git a/game-patches/gadgets/dev_defsdump.lua b/game-patches/gadgets/dev_defsdump.lua
new file mode 100644
index 00000000..35b0b9df
--- /dev/null
+++ b/game-patches/gadgets/dev_defsdump.lua
@@ -0,0 +1,119 @@
+-- Every UnitDef and its weapons, as the game itself has them (after BAR's own post-processing), to defs.json in the
+-- write dir. Inert unless the start script sets dev_defs_dump=1:
+--   python tools/run_match.py ... --minutes 1 --modoption dev_defs_dump=1
+-- his 11-22: "The model needs to know the unit's hp, range, damage, fire rate, movement speed, it needs to understand
+-- all the factors". The army net's unit stats come from this file (tools/armynet/unitstats.py). Ported from
+-- tools/defs_dump_widget.lua so it runs headless.
+
+function gadget:GetInfo()
+	return { name = "BARAI defs dump", desc = "UnitDefs and WeaponDefs to defs.json (dev_defs_dump=1)",
+		author = "bar-ai", layer = 0, enabled = true }
+end
+
+if gadgetHandler:IsSyncedCode() then
+	return
+end
+
+local mo = Spring.GetModOptions and Spring.GetModOptions() or {}
+if tostring(mo.dev_defs_dump or "0") ~= "1" then
+	return
+end
+
+local function esc(s)
+	return '"' .. tostring(s):gsub('\\', '\\\\'):gsub('"', '\\"') .. '"'
+end
+
+local function val(v)
+	local t = type(v)
+	if t == "number" then
+		if v ~= v or v == math.huge or v == -math.huge then return "0" end
+		return string.format("%.6g", v)
+	elseif t == "boolean" then
+		return v and "true" or "false"
+	elseif t == "string" then
+		return esc(v)
+	end
+	return "null"
+end
+
+local function weapon(w)
+	local wd = WeaponDefs[w.weaponDef]
+	if not wd then return nil end
+	local dmg = {}
+	for i = 0, #(Game.armorTypes or {}) do
+		local d = 0
+		pcall(function() d = wd.damages[i] or 0 end)
+		dmg[#dmg + 1] = val(d)
+	end
+	local only, bad = {}, {}
+	for k, on in pairs(w.onlyTargets or {}) do if on then only[#only + 1] = esc(k) end end
+	for k, on in pairs(w.badTargets or {}) do if on then bad[#bad + 1] = esc(k) end end
+	local f = {
+		'"name":' .. esc(wd.name), '"type":' .. esc(wd.type), '"range":' .. val(wd.range),
+		'"reload":' .. val(wd.reload), '"salvo":' .. val(wd.salvoSize), '"projectiles":' .. val(wd.projectiles),
+		'"aoe":' .. val(wd.damageAreaOfEffect), '"edge":' .. val(wd.edgeEffectiveness),
+		'"speed":' .. val(wd.projectilespeed), '"accuracy":' .. val(wd.accuracy), '"spray":' .. val(wd.sprayAngle),
+		'"paralyzer":' .. val(wd.paralyzer), '"high":' .. val(wd.highTrajectory), '"beamtime":' .. val(wd.beamtime),
+		'"stockpile":' .. val(wd.stockpile), '"water":' .. val(wd.waterWeapon), '"interceptor":' .. val(wd.interceptor),
+		'"selfexp":' .. val(wd.selfExplode), '"tracks":' .. val(wd.tracks), '"turret":' .. val(wd.turret),
+		'"heightmod":' .. val(wd.heightMod), '"cylinder":' .. val(wd.cylinderTargeting),
+		'"damages":[' .. table.concat(dmg, ",") .. ']', '"only":[' .. table.concat(only, ",") .. ']',
+		'"bad":[' .. table.concat(bad, ",") .. ']',
+	}
+	return "{" .. table.concat(f, ",") .. "}"
+end
+
+-- headless BAR skips an unsynced gadget whose only call-in is Initialize (gadgets.lua
+-- ShouldSkipHeadlessUnsyncedGadget), so the dump runs once from the first GameFrame
+local dumped = false
+local function dump()
+	local path = tostring(mo.dev_defs_out or "defs.json")
+	local out = io.open(path, "w")
+	if not out then
+		Spring.Echo("[BARAI_DEFS] cannot open " .. path)
+		return
+	end
+	local armor = {}
+	for name, id in pairs(Game.armorTypes or {}) do
+		if type(name) == "string" then armor[#armor + 1] = '"' .. name .. '":' .. tostring(id) end
+	end
+	out:write('{"armor":{' .. table.concat(armor, ",") .. '},"units":{\n')
+	local first = true
+	for id, ud in pairs(UnitDefs) do
+		local ws = {}
+		for _, w in ipairs(ud.weapons or {}) do
+			local s = weapon(w)
+			if s then ws[#ws + 1] = s end
+		end
+		local shieldPower = 0
+		pcall(function()
+			if ud.shieldWeaponDef and WeaponDefs[ud.shieldWeaponDef] then
+				shieldPower = WeaponDefs[ud.shieldWeaponDef].shieldPower or 0
+			end
+		end)
+		local f = {
+			'"id":' .. id, '"metal":' .. val(ud.metalCost), '"energy":' .. val(ud.energyCost),
+			'"health":' .. val(ud.health), '"speed":' .. val(ud.speed), '"turn":' .. val(ud.turnRate),
+			'"accel":' .. val(ud.maxAcc), '"buildtime":' .. val(ud.buildTime), '"armor":' .. val(ud.armorType),
+			'"fly":' .. val(ud.canFly), '"cloak":' .. val(ud.canCloak), '"stealth":' .. val(ud.stealth),
+			'"sonarstealth":' .. val(ud.sonarStealth), '"shield":' .. val(shieldPower), '"sight":' .. val(ud.sightDistance),
+			'"radar":' .. val(ud.radarDistance), '"jammer":' .. val(ud.radarDistanceJam), '"mass":' .. val(ud.mass),
+			'"fx":' .. val(ud.xsize), '"fz":' .. val(ud.zsize), '"building":' .. val(ud.isBuilding),
+			'"builder":' .. val(ud.isBuilder), '"buildspeed":' .. val(ud.buildSpeed), '"selfd":' .. val(ud.selfDCountdown),
+			'"autoheal":' .. val(ud.autoHeal), '"idleheal":' .. val(ud.idleAutoHeal),
+			'"weapons":[' .. table.concat(ws, ",") .. ']',
+		}
+		out:write((first and "" or ",\n") .. esc(ud.name) .. ":{" .. table.concat(f, ",") .. "}")
+		first = false
+	end
+	out:write("\n}}\n")
+	out:close()
+	Spring.Echo("[BARAI_DEFS] wrote " .. path)
+end
+
+function gadget:GameFrame()
+	if not dumped then
+		dumped = true
+		dump()
+	end
+end
diff --git a/tools/armynet/add_def_names.py b/tools/armynet/add_def_names.py
new file mode 100644
index 00000000..4abb2246
--- /dev/null
+++ b/tools/armynet/add_def_names.py
@@ -0,0 +1,132 @@
+#!/usr/bin/env python3
+"""Add def_names to training .npz files built before replay_dataset.py saved them (the army model looks up each unit's
+full stats by name, tools/armynet/unitstats.py). Reads only the D lines of the recording beside each .npz
+(orders.txt.gz or orders.txt in the same folder); no rebuild.
+
+    python tools/armynet/add_def_names.py <roots ...> [--dry]
+    python tools/armynet/add_def_names.py <roots ...> --borrow [--dry]
+        (files whose recording is gone: each def's name from named files with the identical defs row -- same id and
+        same stats is the same unit in the same game version)
+
+A root is a folder searched recursively for *.npz. Files that already carry def_names, or have no recording beside
+them, are skipped and counted.
+"""
+import gzip
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+
+
+def names_from(rec):
+    """{def id: name} from the recording's D lines (written at game start, before the first unit sample)."""
+    op = gzip.open if rec.suffix == ".gz" else open
+    out = {}
+    with op(rec, "rt", encoding="utf-8", errors="replace") as fh:
+        for ln in fh:
+            if ln.startswith("D "):
+                p = ln.split(" ")
+                if len(p) > 2:
+                    out[int(p[1])] = p[2]
+            elif out and ln.startswith("U "):
+                break
+    return out
+
+
+def row_key(r):
+    """A defs row as a key: its id and every stat the recording gave it (rounded), so a borrowed name is only ever
+    taken from the same unit in the same game version."""
+    return (int(r[0]),) + tuple(round(float(v), 3) for v in r[1:])
+
+
+def borrow(roots, dry):
+    """Files with no recording beside them take each def's name from named files whose defs row is identical (same id
+    and same stats: within one game version a def id is the same unit). A row with no match, or with two different
+    names, stays unnamed ("")."""
+    table = {}
+    named, todo = [], []
+    for root in roots:
+        for p in sorted(root.rglob("*.npz")):
+            try:
+                with np.load(p) as z:
+                    if "def_names" in z.files:
+                        named.append(p)
+                        for r, n in zip(z["defs"], z["def_names"]):
+                            if str(n):
+                                table.setdefault(row_key(r), set()).add(str(n))
+                    else:
+                        todo.append(p)
+            except Exception as e:  # noqa: BLE001
+                print("skip %s: %s" % (p, e), flush=True)
+    print("borrow: %d named files give %d distinct rows; %d files to name" % (len(named), len(table), len(todo)),
+          flush=True)
+    done = full = 0
+    for p in todo:
+        try:
+            with np.load(p) as z:
+                data = {k: z[k] for k in z.files}
+            names = []
+            for r in data["defs"]:
+                s = table.get(row_key(r), set())
+                names.append(next(iter(s)) if len(s) == 1 else "")
+            got = sum(1 for n in names if n)
+            if got == len(names):
+                full += 1
+            if dry:
+                print("would name %d of %d defs in %s" % (got, len(names), p.name))
+            else:
+                data["def_names"] = np.array(names)
+                tmp = p.with_name(p.stem + ".tmp.npz")
+                np.savez_compressed(tmp, **data)
+                os.replace(tmp, p)
+            done += 1
+            if done % 50 == 0:
+                print("%d done (%d fully named)" % (done, full), flush=True)
+        except Exception as e:  # noqa: BLE001
+            print("skip %s: %s" % (p, e), flush=True)
+    print("borrowed names for %d files, %d of them fully named" % (done, full))
+
+
+def main(a):
+    dry = "--dry" in a
+    if "--borrow" in a:
+        borrow([Path(x) for x in a if not x.startswith("--")], dry)
+        return 0
+    roots = [Path(x) for x in a if not x.startswith("--")]
+    done = had = norec = bad = 0
+    for root in roots:
+        for p in sorted(root.rglob("*.npz")):
+            try:
+                with np.load(p) as z:
+                    if "def_names" in z.files:
+                        had += 1
+                        continue
+                    rec = next((p.parent / n for n in ("orders.txt.gz", "orders.txt") if (p.parent / n).exists()), None)
+                    if rec is None:
+                        norec += 1
+                        continue
+                    data = {k: z[k] for k in z.files}
+                names = names_from(rec)
+                ids = [int(r[0]) for r in data["defs"]]
+                data["def_names"] = np.array([names.get(i, "") for i in ids])
+                missing = sum(1 for i in ids if i not in names)
+                if dry:
+                    print("would add %d names (%d missing) to %s" % (len(ids), missing, p.name))
+                    done += 1
+                    continue
+                tmp = p.with_name(p.stem + ".tmp.npz")
+                np.savez_compressed(tmp, **data)
+                os.replace(tmp, p)
+                done += 1
+                if done % 50 == 0:
+                    print("%d done" % done, flush=True)
+            except Exception as e:  # noqa: BLE001 -- one bad file must not stop the batch
+                bad += 1
+                print("skip %s: %s" % (p, e), flush=True)
+    print("added %d, already had %d, no recording %d, failed %d" % (done, had, norec, bad))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
diff --git a/tools/armynet/army_speed.py b/tools/armynet/army_speed.py
new file mode 100644
index 00000000..613fdf5a
--- /dev/null
+++ b/tools/armynet/army_speed.py
@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+"""Metal-weighted speed of the army units each side made, by minute, in an armynet game (from barai-gadgets.log
+[BARAI_PROD] and the bridge's armynet_static.txt speeds) -- to set against players' (players_by_minute.py).
+
+    python tools/armynet/army_speed.py <engine write dir> ...
+"""
+import collections
+import re
+import sys
+from pathlib import Path
+
+PROD = re.compile(r"\[BARAI_PROD\] team=(\d+) ally=\d+ frame=(\d+) min=[\d.]+ unit=(\w+) cost=([\d.]+)")
+
+
+def main(a):
+    for d in a:
+        d = Path(d)
+        speed, cls = {}, {}
+        for ln in open(d / "armynet_static.txt", errors="replace"):
+            p = ln.split()
+            if p and p[0] == "D":
+                speed[p[2]], cls[p[2]] = float(p[6]), p[3]
+        made = collections.defaultdict(list)
+        for ln in open(d / "barai-gadgets.log", errors="replace"):
+            m = PROD.search(ln)
+            if m and cls.get(m.group(3)) in ("army", "air"):
+                made[(int(m.group(1)), int(m.group(2)) // 1800 // 4 * 4)].append((m.group(3), float(m.group(4))))
+        print(d.name)
+        for t in (0, 1):
+            cells = []
+            for mins in range(0, 24, 4):
+                rows = made.get((t, mins), [])
+                w = sum(c for _, c in rows)
+                s = sum(speed.get(u, 0) * c for u, c in rows) / w if w else float("nan")
+                top = collections.Counter(u for u, _ in rows).most_common(2)
+                cells.append("%2d-%2d: %5.1f %s" % (mins, mins + 3, s, ",".join("%s x%d" % kv for kv in top)))
+            print("  team %d  " % t + " | ".join(cells))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
