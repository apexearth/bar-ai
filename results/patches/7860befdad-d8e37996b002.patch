@@ -0,0 +1,66 @@
+#!/usr/bin/env python3
+"""How much of the training data is navy, hovers and amphibious units (his 11-19: "for army what about navy?").
+
+    python tools/armynet/navy_share.py
+
+Per duel dataset, the army metal finished by kind of movement (ships and subs, hovers, amphibious, land, air), from
+the movement columns replay_dataset.py writes (defs columns 12-16); games with any ship count as naval games.
+"""
+import glob
+import sys
+
+import numpy as np
+
+KINDS = ("ship", "sub", "hover", "amphibious", "land", "air")
+
+
+def kind(move, cls):
+    land, water, under, _slope, _wade = move
+    if cls == 4:
+        return "air"
+    if not land and water:
+        return "sub" if under else "ship"
+    if land and water:
+        return "hover"
+    if land and under:
+        return "amphibious"
+    return "land"
+
+
+def main(a):
+    files = sorted(glob.glob("G:/bar-ai-archive/public-replays/recordings/*/*.npz")) + \
+        sorted(glob.glob("G:/bar-ai-archive/replay-orders/*/*.npz"))
+    tot = dict.fromkeys(KINDS, 0.0)
+    naval_games = games = 0
+    for p in files:
+        try:
+            z = np.load(p)
+            units, defs = z["units"], z["defs"]
+        except Exception:
+            continue
+        if defs.shape[1] < 17:
+            continue
+        games += 1
+        row = {int(r[0]): r for r in defs}
+        first = {}
+        for r in units:
+            uid = int(r[1])
+            if uid not in first and r[9] >= 1:
+                first[uid] = int(r[2])
+        game = dict.fromkeys(KINDS, 0.0)
+        for d in first.values():
+            r = row.get(d)
+            if r is None or int(r[1]) not in (3, 4):
+                continue
+            game[kind(r[12:17], int(r[1]))] += r[2]
+        if game["ship"] + game["sub"] > 0:
+            naval_games += 1
+        for k in KINDS:
+            tot[k] += game[k]
+    s = sum(tot.values()) or 1
+    print("duels %d, with ships or subs %d (%.0f%%)" % (games, naval_games, 100 * naval_games / max(games, 1)))
+    print("army metal finished: " + ", ".join("%s %.1f%%" % (k, 100 * tot[k] / s) for k in KINDS))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
diff --git a/tools/armynet/netrun.py b/tools/armynet/netrun.py
new file mode 100644
index 00000000..22c98127
--- /dev/null
+++ b/tools/armynet/netrun.py
@@ -0,0 +1,97 @@
+"""The army model behind one interface, run by PyTorch (a .pt checkpoint) or by ONNX Runtime (a folder from
+export_onnx.py: no PyTorch needed, his 11-24 "easy for anyone ... even if it was on a CPU"). Everything in and out is
+numpy, so serve.py does not import torch on the ONNX path.
+"""
+import json
+from pathlib import Path
+
+import numpy as np
+
+MAIN_IN = ["grid", "scal", "tok", "mask", "etok", "emask"]
+MAIN_OUT = ["h", "act", "kind", "cells", "u64", "value", "b_eco"]
+FORCE_OUT = ["fh", "act", "kind", "cells", "goal", "member", "spread", "shape", "alive", "present"]
+
+
+def softmax(x, axis=-1):
+    x = np.asarray(x, np.float64)
+    e = np.exp(x - x.max(axis, keepdims=True))
+    return (e / e.sum(axis, keepdims=True)).astype(np.float32)
+
+
+def sigmoid(x):
+    return (1.0 / (1.0 + np.exp(-np.asarray(x, np.float64)))).astype(np.float32)
+
+
+class TorchNet:
+    def __init__(self, path, dev, threads):
+        import torch
+        from model import ArmyNet, arch_of, load_widened
+        self.torch = torch
+        if dev == "cpu":
+            torch.set_num_threads(threads)
+        self.dev = dev
+        self.model = ArmyNet(*arch_of(path)).to(dev)
+        load_widened(self.model, path, dev)
+        self.model.eval()
+        self.has_member = bool(path) and any(k.startswith("f_member.") for k in torch.load(path, map_location="cpu"))
+        self.name = "torch " + dev
+
+    def _t(self, x):
+        return self.torch.from_numpy(np.ascontiguousarray(x)).to(self.dev)
+
+    def _n(self, d):
+        return {k: v.float().cpu().numpy() if v.is_floating_point() else v.cpu().numpy() for k, v in d.items()}
+
+    def step(self, b):
+        with self.torch.no_grad():
+            o = self.model(*[self._t(b[k]) for k in MAIN_IN])
+        return self._n({k: o[k] for k in MAIN_OUT})
+
+    def forces(self, h, u64, force):
+        with self.torch.no_grad():
+            return self._n(self.model.forces(self._t(h), self._t(u64), self._t(force.astype(np.int64))))
+
+    def offset_at(self, h, u64, cell):
+        with self.torch.no_grad():
+            return self.model.offset_at(self._t(h), self._t(u64), self._t(cell.astype(np.int64))).float().cpu().numpy()
+
+
+class OnnxNet:
+    def __init__(self, folder, threads):
+        import onnxruntime as ort
+        so = ort.SessionOptions()
+        so.intra_op_num_threads = threads
+        so.inter_op_num_threads = 1
+        # idle worker threads spin by default: eight servers beside a game burned the cores it needed
+        so.add_session_config_entry("session.intra_op.allow_spinning", "0")
+        prov = ["CPUExecutionProvider"]
+        folder = Path(folder)
+        self.s = {k: ort.InferenceSession(str(folder / (k + ".onnx")), so, providers=prov)
+                  for k in ("main", "forces", "offset")}
+        meta = json.loads((folder / "meta.json").read_text()) if (folder / "meta.json").exists() else {}
+        self.has_member = bool(meta.get("has_member", True))
+        self.name = "onnx cpu x%d" % threads
+
+    def step(self, b):
+        r = self.s["main"].run(None, {k: np.ascontiguousarray(b[k]) for k in MAIN_IN})
+        return dict(zip(MAIN_OUT, r))
+
+    def forces(self, h, u64, force):
+        force = force.astype(np.int64)
+        nf = max(int(force.max()) + 1 if force.size else 0, 1)
+        r = self.s["forces"].run(None, {"h": h, "u64": u64, "force": force, "slots": np.zeros((1, nf), np.float32)})
+        return dict(zip(FORCE_OUT, r))
+
+    def offset_at(self, h, u64, cell):
+        return self.s["offset"].run(None, {"h": np.ascontiguousarray(h, np.float32), "u64": u64,
+                                           "cell": cell.astype(np.int64)})[0]
+
+
+def load(path, cpu=False, threads=2):
+    """A folder (or a .onnx file's folder) runs on ONNX Runtime; a .pt on PyTorch, the GPU when there is one."""
+    p = Path(path)
+    if p.is_dir() or p.suffix == ".onnx":
+        return OnnxNet(p if p.is_dir() else p.parent, threads)
+    import torch
+    dev = "cpu" if cpu else ("cuda" if torch.cuda.is_available() else "cpu")
+    return TorchNet(path, dev, threads)
diff --git a/tools/armynet/npz_pull.py b/tools/armynet/npz_pull.py
new file mode 100644
index 00000000..8f5134c3
--- /dev/null
+++ b/tools/armynet/npz_pull.py
@@ -0,0 +1,29 @@
+"""Pull every .npz an npz_share.py-style server lists (GET /list, GET /<root>/<game>/<name>) into <out>/<game>/<name>;
+a file already there at the listed size is skipped.
+
+    python tools/armynet/npz_pull.py <base url> <out dir>
+"""
+import sys
+import urllib.parse
+import urllib.request
+from pathlib import Path
+
+base, out = sys.argv[1].rstrip("/"), Path(sys.argv[2])
+rows = [ln.split("\t") for ln in urllib.request.urlopen(base + "/list", timeout=60).read().decode().splitlines() if ln]
+done = 0
+for root, game, name, size, _ in rows:
+    dst = out / game / name
+    if dst.exists() and dst.stat().st_size == int(size):
+        continue
+    dst.parent.mkdir(parents=True, exist_ok=True)
+    tmp = dst.with_suffix(".part")
+    url = "%s/%s/%s/%s" % (base, *(urllib.parse.quote(x) for x in (root, game, name)))
+    with urllib.request.urlopen(url, timeout=300) as r, open(tmp, "wb") as f:
+        while True:
+            b = r.read(1 << 20)
+            if not b:
+                break
+            f.write(b)
+    tmp.replace(dst)
+    done += 1
+print("pulled %d of %d into %s" % (done, len(rows), out))
