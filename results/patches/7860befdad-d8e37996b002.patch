+// His 11-16: one line so players know who is who -- every AI of ours in the game by the name the lobby shows, and the
+// version this library runs. The first AI of this library to ask gets it; every later ask in the process gets "".
+static std::string CCircuitAI_RosterLineOnce(CCircuitAI* circuit)
+{
+	static bool said = false;
+	if (said) {
+		return "";
+	}
+	said = true;
+	std::string myShort;
+	{
+		std::unique_ptr<springai::Info> info(circuit->GetSkirmishAI()->GetInfo());
+		const char* s = info->GetValueByKey("shortName");
+		myShort = (s != nullptr) ? s : "";
+	}
+	auto lower = [](std::string v) { for (char& c : v) c = std::tolower((unsigned char)c); return v; };
+	auto trim = [](std::string v) {
+		const size_t a = v.find_first_not_of(" \t\r");
+		const size_t b = v.find_last_not_of(" \t\r;");
+		return (a == std::string::npos) ? std::string() : v.substr(a, b - a + 1);
+	};
+	const std::string script = circuit->GetGame()->GetSetupScript();
+	// each host's process speaks once, for the Apex AIs it runs: two players hosting Apex AIs gave two full lists
+	std::vector<std::pair<std::string, std::string>> found;
+	const std::string myTeam = std::to_string(circuit->GetTeamId());
+	std::string myHost;
+	std::string name, shortName, version, team, host;
+	bool inAi = false;
+	int depth = 0;
+	size_t pos = 0;
+	while (pos <= script.size()) {
+		size_t eol = script.find('\n', pos);
+		if (eol == std::string::npos) {
+			eol = script.size();
+		}
+		const std::string line = trim(script.substr(pos, eol - pos));
+		pos = eol + 1;
+		if (!inAi) {
+			const std::string l = lower(line);
+			if ((l.rfind("[ai", 0) == 0) && (l.find(']') != std::string::npos)) {
+				inAi = true;
+				depth = 0;
+				name.clear(); shortName.clear(); version.clear(); team.clear(); host.clear();
+			}
+			continue;
+		}
+		for (char c : line) {
+			if (c == '{') ++depth;
+			else if (c == '}') --depth;
+		}
+		if ((depth == 1) && (line.find('=') != std::string::npos)) {
+			const size_t eq = line.find('=');
+			const std::string k = lower(trim(line.substr(0, eq)));
+			const std::string v = trim(line.substr(eq + 1));
+			if (k == "name") name = v;
+			else if (k == "shortname") shortName = v;
+			else if (k == "version") version = v;
+			else if (k == "team") team = v;
+			else if (k == "host") host = v;
+		}
+		if ((depth <= 0) && (line.find('}') != std::string::npos)) {
+			inAi = false;
+			if (team == myTeam) {
+				myHost = host;
+			}
+			// a hosted game names no version and loads the highest one installed: this library
+			if ((lower(shortName) == lower(myShort)) && (version.empty() || (version == circuit->GetAiVersion()))
+				&& !name.empty()) {
+				// the name players see: the game names AIs at random (luarules ai_namer.lua, rules param ainame_<team>)
+				const std::string shown = team.empty() ? std::string()
+						: circuit->GetGame()->GetRulesParamString(("ainame_" + team).c_str(), "");
+				found.emplace_back(host, shown.empty() ? name : shown);
+			}
+		}
+	}
+	std::vector<std::string> names;
+	for (const auto& f : found) {
+		if (myHost.empty() || (f.first == myHost)) {
+			names.push_back(f.second);
+		}
+	}
+	const std::string apex = "Apex " + circuit->GetAiVersion();
+	if (names.empty()) {
+		return apex;
+	}
+	std::string who;
+	for (size_t i = 0; i < names.size(); ++i) {
+		who += ((i == 0) ? "" : ((i + 1 == names.size()) ? " and " : ", ")) + names[i];
+	}
+	return who + ((names.size() == 1) ? " is " : " are ") + apex;
+}
+
+// The engine's Pos2BuildPos snap (GameHelper.cpp): every building lands on the
+// 16-elmo build grid, with a half-square offset when the footprint size has
+// bit 2 set, so EDGES always meet the grid. Script placement math computes
+// intent in raw elmos; snapping the intent with the same rule keeps rows and
+// walkway gaps exact for every footprint instead of drifting +-8 per def.
+// apexearth: "can we try to ensure that we place it on a floored 2 mod grid
+// of the map? ... this is for any buildings."
+static springai::AIFloat3 CCircuitAI_SnapBuildPos(CCircuitAI* circuit, CCircuitDef* cdef, const springai::AIFloat3& pos)
+{
+	if (cdef == nullptr) {
+		return pos;
+	}
+	constexpr float BUILD_SQ = SQUARE_SIZE * 2;
+	springai::AIFloat3 out = pos;
+	if (cdef->GetDef()->GetXSize() & 2) {
+		out.x = std::floor(pos.x / BUILD_SQ) * BUILD_SQ + SQUARE_SIZE;
+	} else {
+		out.x = std::floor((pos.x + SQUARE_SIZE) / BUILD_SQ) * BUILD_SQ;
+	}
+	if (cdef->GetDef()->GetZSize() & 2) {
+		out.z = std::floor(pos.z / BUILD_SQ) * BUILD_SQ + SQUARE_SIZE;
+	} else {
+		out.z = std::floor((pos.z + SQUARE_SIZE) / BUILD_SQ) * BUILD_SQ;
+	}
+	return out;
+}
