+    standing = {"radar": [], "jam": []}
+    stacked = 0
+    for _f, died, m in ev:
+        kind = "radar" if m.group(3) in ("rad", "frad", "arad") else "jam"
+        x, z = float(m.group(4)), float(m.group(5))
+        if died:
+            near = min(range(len(standing[kind])), default=None,
