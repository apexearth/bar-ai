+// The army that screens home: inside the leash and not retreating. Runs under
+// the stock army, where ArmyCoverSample does not.
+int   gHomeArmyAt = -999999;
+float gHomeArmyM = 0.f;
+float HomeArmyM()
+{
+	if (ai.frame < gHomeArmyAt + 2 * SECOND)
+		return gHomeArmyM;
+	gHomeArmyAt = ai.frame;
+	float homeM = 0.f;
+	if (Builder::gHomeSet) {
+		const float leash = ai.GetTunable("apex_eco_leash", TUNE_ECO_LEASH);
+		for (uint i = 0; i < gCombatId.length(); ++i) {
+			CCircuitUnit@ u = ai.GetTeamUnit(Id(gCombatId[i]));
+			if ((u is null) || (u.circuitDef is null))
+				continue;
+			const AIFloat3 p = u.GetPos(ai.frame);
+			if (!OnMap(p))
+				continue;
+			IUnitTask@ t = u.task;
+			if ((t !is null) && (t.GetType() == Task::Type::RETREAT))
+				continue;
+			const int d = int(u.circuitDef.id);
+			if (p.distance2D(Builder::gHomePos) <= leash + PostReach(d))
+				homeM += Catalog::gCostM[d];
+		}
+	}
+	gHomeArmyM = homeM;
+	return homeM;
+}
