@@ -0,0 +1,66 @@
+#!/usr/bin/env python3
+"""How much of the training data is navy, hovers and amphibious units (his 11-19: "for army what about navy?").
+
+    python tools/armynet/navy_share.py
+
+Per duel dataset, the army metal finished by kind of movement (ships and subs, hovers, amphibious, land, air), from
+the movement columns replay_dataset.py writes (defs columns 12-16); games with any ship count as naval games.
+"""
+import glob
+import sys
+
+import numpy as np
+
+KINDS = ("ship", "sub", "hover", "amphibious", "land", "air")
+
+
+def kind(move, cls):
+    land, water, under, _slope, _wade = move
+    if cls == 4:
+        return "air"
+    if not land and water:
+        return "sub" if under else "ship"
+    if land and water:
+        return "hover"
+    if land and under:
+        return "amphibious"
+    return "land"
+
+
+def main(a):
+    files = sorted(glob.glob("G:/bar-ai-archive/public-replays/recordings/*/*.npz")) + \
+        sorted(glob.glob("G:/bar-ai-archive/replay-orders/*/*.npz"))
+    tot = dict.fromkeys(KINDS, 0.0)
+    naval_games = games = 0
+    for p in files:
+        try:
+            z = np.load(p)
+            units, defs = z["units"], z["defs"]
+        except Exception:
+            continue
+        if defs.shape[1] < 17:
+            continue
+        games += 1
+        row = {int(r[0]): r for r in defs}
+        first = {}
+        for r in units:
+            uid = int(r[1])
+            if uid not in first and r[9] >= 1:
+                first[uid] = int(r[2])
+        game = dict.fromkeys(KINDS, 0.0)
+        for d in first.values():
+            r = row.get(d)
+            if r is None or int(r[1]) not in (3, 4):
+                continue
+            game[kind(r[12:17], int(r[1]))] += r[2]
+        if game["ship"] + game["sub"] > 0:
+            naval_games += 1
+        for k in KINDS:
+            tot[k] += game[k]
+    s = sum(tot.values()) or 1
+    print("duels %d, with ships or subs %d (%.0f%%)" % (games, naval_games, 100 * naval_games / max(games, 1)))
+    print("army metal finished: " + ", ".join("%s %.1f%%" % (k, 100 * tot[k] / s) for k in KINDS))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
diff --git a/tools/armynet/npz_share.py b/tools/armynet/npz_share.py
new file mode 100644
index 00000000..16cb3076
--- /dev/null
+++ b/tools/armynet/npz_share.py
@@ -0,0 +1,73 @@
+#!/usr/bin/env python3
+"""Read-only share of the army model's training files for the Mac (his 11-21: "it is fine to share a folder from
+this PC, just for this stuff").
+
+    python tools/armynet/npz_share.py [--port 8765]
+
+Serves only .npz files under the two recording roots, nothing else:
+    GET /list                          one line per file: root TAB game TAB name TAB bytes TAB mtime
+    GET /<root>/<game>/<name>.npz      the file (root: recordings | replay-orders)
+Answers only the home network (192.168.0.0/16) and Tailscale (100.64.0.0/10); every request is logged.
+"""
+import ipaddress
+import os
+import sys
+import time
+import urllib.parse
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+ROOTS = {"recordings": Path("G:/bar-ai-archive/public-replays/recordings"),
+         "replay-orders": Path("G:/bar-ai-archive/replay-orders")}
+ALLOW = [ipaddress.ip_network("192.168.0.0/16"), ipaddress.ip_network("100.64.0.0/10"),
+         ipaddress.ip_network("127.0.0.0/8")]
+LOG = Path("G:/bar-ai-archive/npz-share.log")
+
+
+class Handler(BaseHTTPRequestHandler):
+    def log_message(self, fmt, *args):
+        with open(LOG, "a", encoding="utf-8") as f:
+            f.write("%s %s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), self.client_address[0], fmt % args))
+
+    def do_GET(self):
+        ip = ipaddress.ip_address(self.client_address[0])
+        if not any(ip in n for n in ALLOW):
+            return self.send_error(403)
+        path = urllib.parse.unquote(urllib.parse.urlparse(self.path).path).strip("/")
+        if path == "list":
+            lines = []
+            for label, root in ROOTS.items():
+                for p in root.glob("*/*.npz"):
+                    st = p.stat()
+                    lines.append("%s\t%s\t%s\t%d\t%d" % (label, p.parent.name, p.name, st.st_size, st.st_mtime))
+            body = ("\n".join(lines) + "\n").encode("utf-8")
+            self.send_response(200)
+            self.send_header("Content-Type", "text/plain; charset=utf-8")
+            self.send_header("Content-Length", str(len(body)))
+            self.end_headers()
+            return self.wfile.write(body)
+        parts = path.split("/")
+        if len(parts) != 3 or parts[0] not in ROOTS or not parts[2].endswith(".npz") or ".." in path:
+            return self.send_error(404)
+        f = (ROOTS[parts[0]] / parts[1] / parts[2]).resolve()
+        if ROOTS[parts[0]].resolve() not in f.parents or not f.is_file():
+            return self.send_error(404)
+        size = f.stat().st_size
+        self.send_response(200)
+        self.send_header("Content-Type", "application/octet-stream")
+        self.send_header("Content-Length", str(size))
+        self.end_headers()
+        with open(f, "rb") as fh:
+            while chunk := fh.read(1 << 20):
+                self.wfile.write(chunk)
+
+
+def main(a):
+    port = int(a[a.index("--port") + 1]) if "--port" in a else 8765
+    srv = ThreadingHTTPServer(("0.0.0.0", port), Handler)
+    print("serving .npz on port %d (pid %d)" % (port, os.getpid()), flush=True)
+    srv.serve_forever()
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
