+#!/usr/bin/env python3
+"""Time each part of one live decision the way serve.py makes it (budget at 10x and STEP=10: 33 ms).
+
+    python tools/armynet/bench_serve.py <dataset.npz> --model <model.pt> [--minute 18] [--n 10]
+"""
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from data import G, RECENT_S, STEP, Game, collate, fold_history, history_rows  # noqa: E402
+from model import ArmyNet, load_widened  # noqa: E402
+
+
+def main(a):
+    path = a[0]
+    opt = lambda k, d: a[a.index(k) + 1] if k in a else d
+    minute, n = float(opt("--minute", "18")), int(opt("--n", "10"))
+    dev = "cuda" if torch.cuda.is_available() else "cpu"
+    model = ArmyNet().to(dev)
+    load_widened(model, opt("--model", ""), dev, log=lambda *_: None)
+    model.eval()
+    z = np.load(path)
+    u = z["units"]
+    team = int(z["teams"][0][0])
+    t = {k: [] for k in ("history", "live", "example", "forward x3", "regions", "total")}
+    f0 = int(minute * 1800) // STEP * STEP
+    stores = {}
+    for i in range(n):
+        f = f0 + i * STEP
+        t0 = time.perf_counter()
+        sd = np.array(sorted(int(r[0]) for r in z["defs"] if int(r[1]) == 0), np.int64)
+        old = u[(u[:, 0] < f - RECENT_S * 30) & (u[:, 0] >= f - RECENT_S * 30 - STEP)]  # one step folded, as serve
+        store = fold_history(stores.setdefault("s", fold_history({}, u[u[:, 0] < f - RECENT_S * 30 - STEP],
+                                                                  len(z["allies"]))), old, len(z["allies"]))
+        hist = history_rows(store, u[(u[:, 0] <= f) & (u[:, 0] >= f - RECENT_S * 30)], f, sd)
+        t1 = time.perf_counter()
+        g = Game.live(hist, z["defs"], z["map"], z["allies"], z["teams"], z["spots"], z["heights"],
+                      orders=z["decisions"][z["decisions"][:, 0] < f], task_starts=None,
+                      hits=z["hits"] if "hits" in z.files else None)
+        t2 = time.perf_counter()
+        ex = g.example(team, f)
+        t3 = time.perf_counter()
+        for _ in range(3):
+            b = collate([ex])
+            with torch.no_grad():
+                o = model(b["grid"].to(dev), b["scal"].to(dev), b["tok"].to(dev), b["mask"].to(dev))
+                c = o["cells"][0].argmax(-1)
+                model.offset_at(o["h"], o["u64"], c[None])
+                probs = torch.softmax(o["cells"][0].float(), -1).cpu().numpy()
+        t4 = time.perf_counter()
+        from train import base_axis
+        sx, sz = float(z["map"][0]) / G, float(z["map"][1]) / G
+        axis = base_axis(ex["grid"], sx, sz, float(z["map"][0]), float(z["map"][1]))
+        cz_, cx_ = np.mgrid[0:G, 0:G]
+        cell_fwd = axis((cx_ + .5) * sx, (cz_ + .5) * sz).ravel()
+        fu = np.asarray(axis(ex["tok"][:, 10] * float(z["map"][0]), ex["tok"][:, 11] * float(z["map"][1])))
+        back = cell_fwd[None, :] < fu[:, None] - 0.1
+        fwd = cell_fwd[None, :] > fu[:, None] + 0.1
+        regions = np.stack([back, fwd, ~(back | fwd)], 1)
+        (probs[:, None, :] * regions).sum(-1)
+        t5 = time.perf_counter()
+        for k, v in zip(t, (t1 - t0, t2 - t1, t3 - t2, t4 - t3, t5 - t4, t5 - t0)):
+            t[k].append(v)
+    print("units in the window %d, tokens %d" % (len(hist), len(ex["tok"])))
+    for k, v in t.items():
+        print("%-12s %6.1f ms" % (k, 1000 * np.median(v[1:] if len(v) > 1 else v)))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
diff --git a/tools/armynet/campaign.py b/tools/armynet/campaign.py
new file mode 100644
index 00000000..2682144c
--- /dev/null
+++ b/tools/armynet/campaign.py
@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+"""Train the army model without end and give him a watch game for every N steps (his 11-18).
+
+    python tools/armynet/campaign.py [--every 10000] [--init <model.pt>] [--minutes 40]
+
+Three loops: the datasets of new recordings are built every 10 minutes (overnight.py --build-only); one training
+run goes on (train.py --constant-lr --refresh --save-every N: the game list re-read every 10 minutes, a numbered
+checkpoint every N steps); each new checkpoint gets a watch game (watch.py: the lane AI both sides, side A's army
+the checkpoint's), never while his own game runs and one at a time. Every game writes one line to
+runtime/armynet/campaign-<stamp>/campaign.log: the step, the last held-out eval, the winner and length, and side A's
+contract numbers against side B's (raider repeat kills /10 min, ground given up).
+"""
+import glob
+import json
+import re
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(REPO / "tools"))
+import contract  # noqa: E402
+import mp_archive  # noqa: E402
+
+
+def score(match_dir):
+    res = (json.loads((match_dir / "result.json").read_text()).get("result") or {}) if (match_dir / "result.json").exists() else {}
+    seats = {s.team: s for s in contract.load(match_dir)} if (match_dir / "infolog.txt").exists() else {}
+    def num(team, fn):
+        s = seats.get(team)
+        v = fn(s) if s else None
+        return None if v is None else round(v, 2)
+    return {"winners": res.get("winners"), "minutes": res.get("game_minutes") or res.get("minutes"),
+            "reason": res.get("reason"),
+            "raider_repeats_A": num(0, contract.raider_repeat_kills), "raider_repeats_B": num(1, contract.raider_repeat_kills),
+            "ground_given_up_A": num(0, contract.ground_given_up), "ground_given_up_B": num(1, contract.ground_given_up)}
+
+
+def last_eval(log):
+    try:
+        lines = [l for l in log.read_text(errors="replace").splitlines() if l.startswith("eval ")]
+    except OSError:
+        return None
+    return lines[-1][5:] if lines else None
+
+
+def main(a):
+    def opt(name, default):
+        return a[a.index(name) + 1] if name in a else default
+    every = int(opt("--every", "10000"))
+    out = REPO / "runtime" / "armynet" / ("campaign-" + time.strftime("%Y%m%d-%H%M"))
+    out.mkdir(parents=True, exist_ok=True)
+    clog = open(out / "campaign.log", "a", buffering=1)
+    builder = subprocess.Popen([sys.executable, "-u", str(REPO / "tools" / "armynet" / "overnight.py"), "--build-only"],
+                               stdout=open(out / "build.log", "w"), stderr=subprocess.STDOUT)
+    cmd = [sys.executable, "-u", str(REPO / "tools" / "armynet" / "train.py"), "--steps", "100000000", "--constant-lr",
+           "--refresh", "--save-every", str(every), "--batch", "32", "--workers", opt("--workers", "4"),
+           "--out", str(out)]
+    if "--init" in a:
+        cmd += ["--init", opt("--init", ""), "--start-step", opt("--start-step", "0")]
+    if "--mirror" in a:
+        cmd += ["--mirror"]
+    if "--late" in a:
+        cmd += ["--late"]
+    if "--rounds" in a:
+        cmd += ["--rounds"]
+    trainer = subprocess.Popen(cmd, stdout=open(out / "train.log", "w"), stderr=subprocess.STDOUT)
+    clog.write("campaign %s: a watch game every %d steps\n" % (out.name, every))
+    watched = set()
+    try:
+        while trainer.poll() is None:
+            ckpts = sorted(glob.glob(str(out / "model-*.pt")))
+            new = [c for c in ckpts if c not in watched]
+            if new and not mp_archive.his_game_running():
+                ck = new[-1]
+                watched.update(new)
+                step = int(re.search(r"model-(\d+)", ck).group(1))
+                # his 11-19: "stop the watch games for now" -- with --headless N each checkpoint plays N games with no
+                # window (seeds alternate the faction), for tools/armynet/gaps.py
+                games = int(opt("--headless", "0")) or 1
+                for gi in range(games):
+                    seed = step // every * games + gi
+                    clog.write("step %d: game %d starting (seed %d)\n" % (step, gi + 1, seed))
+                    wlog = out / ("watch-%06d-%d.log" % (step, gi))
+                    subprocess.run([sys.executable, str(REPO / "tools" / "armynet" / "watch.py"), "--model", ck,
+                                    "--minutes", opt("--minutes", "40"), "--seed", str(seed),
+                                    *(["--headless"] if "--headless" in a else []),
+                                    *(["--rounds"] if "--rounds" in a else []), "--speed", opt("--speed", "4")], check=False,
+                                   stdout=open(wlog, "w"), stderr=subprocess.STDOUT)
+                    # the game's own folder, from the write dir watch.py printed (11-19: "the newest new folder"
+                    # took another run's game when two overlapped)
+                    m = re.search(r"watch-armynet-engine-([\d-]+)", wlog.read_text(errors="replace"))
+                    made = [str(REPO / "matches" / ("armynet-watch-" + m.group(1)))] if m else []
+                    row = {"step": step, "game": gi + 1, "seed": seed, "eval": last_eval(out / "train.log")}
+                    if made:
+                        row.update(score(Path(made[-1])))
+                        row["match"] = Path(made[-1]).name
+                        # report.md, lane.png, film-N.png, timelapse.gif beside the match (his 11-19)
+                        subprocess.run([sys.executable, str(REPO / "tools" / "armynet" / "game_report.py"), made[-1]],
+                                       check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+                    clog.write("RESULT " + json.dumps(row) + "\n")
+            time.sleep(60)
+    finally:
+        builder.terminate()
+    clog.write("trainer exited %s\n" % trainer.returncode)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
diff --git a/tools/armynet/click_rate.py b/tools/armynet/click_rate.py
new file mode 100644
index 00000000..a352377c
--- /dev/null
+++ b/tools/armynet/click_rate.py
@@ -0,0 +1,82 @@
+#!/usr/bin/env python3
+"""How fast players re-order a unit (his 11-19: "if its kiting probably can efficiently do it 2 or 3 times a second").
+
+    python tools/armynet/click_rate.py [N recordings]
+
+From the recordings' C lines (every click, at its frame): for army and air units, the time between one order to a unit
+and the next. Split by whether an enemy army unit stood within 800 of it at the nearest 1-s sample (in a fight) or
+not. Prints the share of re-orders within 0.2 / 0.33 / 0.5 / 1 / 1.5 s and the median, and the share of a unit's
+in-fight seconds that hold 2+ orders.
+"""
+import collections
+import glob
+import gzip
+import random
+import sys
+
+import numpy as np
+
+FIGHT_R = 800.0
+
+
+def one(path):
+    cls, ally = {}, {}
+    pos = collections.defaultdict(dict)   # frame -> uid -> (x, z, team)
+    clicks = collections.defaultdict(list)
+    for ln in gzip.open(path, "rt", errors="replace"):
+        p = ln.split()
+        if not p:
+            continue
+        k = p[0]
+        if k == "D":
+            cls[int(p[1])] = p[3]
+        elif k == "T":
+            ally[int(p[1])] = int(p[2])
+        elif k == "U":
+            f, uid, d, t = int(p[1]), int(p[2]), int(p[3]), int(p[4])
+            if cls.get(d) in ("army", "air"):
+                pos[f][uid] = (float(p[5]), float(p[6]), t)
+        elif k == "C":
+            f, t, uid, d, cmd = int(p[1]), int(p[2]), int(p[3]), int(p[4]), int(p[5])
+            if cls.get(d) in ("army", "air") and cmd in (10, 16, 20, 15, 21, 0):
+                clicks[uid].append(f)
+    frames = np.array(sorted(pos))
+    fight_iv, calm_iv = [], []
+    for uid, fs in clicks.items():
+        fs = sorted(fs)
+        for a, b in zip(fs, fs[1:]):
+            if b == a:
+                continue
+            i = int(np.searchsorted(frames, a, "right")) - 1
+            if i < 0:
+                continue
+            snap = pos[frames[i]]
+            me = snap.get(uid)
+            if me is None:
+                continue
+            x, z, t = me
+            fight = any(ally.get(t2, -1) != ally.get(t, -2) and (x2 - x) ** 2 + (z2 - z) ** 2 <= FIGHT_R ** 2
+                        for x2, z2, t2 in snap.values())
+            (fight_iv if fight else calm_iv).append((b - a) / 30.0)
+    return fight_iv, calm_iv
+
+
+def main(a):
+    n = int(a[0]) if a else 20
+    files = sorted(glob.glob("G:/bar-ai-archive/public-replays/recordings/*/orders.txt.gz"))
+    random.seed(7)
+    fight, calm = [], []
+    for p in random.sample(files, min(n, len(files))):
+        f, c = one(p)
+        fight += f
+        calm += c
+    for name, v in (("in a fight", fight), ("not in a fight", calm)):
+        v = np.array(v)
+        if not len(v):
+            continue
+        print("%-15s re-orders %7d  median %.2f s  within 0.2 s %.0f%%  0.33 s %.0f%%  0.5 s %.0f%%  1 s %.0f%%  1.5 s %.0f%%"
+              % (name, len(v), np.median(v), *(100 * np.mean(v <= t) for t in (0.2, 0.33, 0.5, 1.0, 1.5))))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
diff --git a/tools/armynet/data.py b/tools/armynet/data.py
