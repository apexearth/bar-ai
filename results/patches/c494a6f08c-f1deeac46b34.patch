diff --git a/ai/Unstable/game-side/script/standard/manager/military/breach.as b/ai/Unstable/game-side/script/standard/manager/military/breach.as
new file mode 100644
index 00000000..e186a28f
--- /dev/null
+++ b/ai/Unstable/game-side/script/standard/manager/military/breach.as
@@ -0,0 +1,190 @@
+namespace Military {
+
+//------------------------------------------------------------------------------
+// A FRONT THAT DOES NOT BREAK (his 11-12). Humans answer big attacks with more and more defences until every attack
+// is futile, and an AI that keeps throwing the same attack at them loses with time.
+//
+// The breach state is on while what we lose on their ground outweighs what we kill there. That is the death
+// ledger's own two rows (gBleedFwd, gKillFwd), decayed together, over at least a trade's worth of income. The
+// breach site is the armed group nearest where their guns kill us (TurretTarget).
+//
+// Each site keeps a memory of its tries. A try is broken when the armed buildings destroyed there reach half the
+// armed metal seen there; that is a count of real kills, not of what is in view. It fails when a full try passes
+// without that. A failed site rests while the next try goes elsewhere or with other tools.
+//------------------------------------------------------------------------------
+
+class BreachSite {
+	AIFloat3 pos;
+	int since = 0;          // frame the current try began
+	float seenM = 0.f;      // armed metal seen there during this try, at most
+	float killedM = 0.f;    // armed buildings of theirs destroyed within reach of it during this try
+	float lost0 = 0.f;      // cumulative metal lost to static guns when the try began
+	int tries = 0;
+	int broken = 0;
+	int failedUntil = -1;
+}
+
+const float BREACH_SITE_R = 1200.f;
+const int BREACH_TRY = 5 * MINUTE;
+const int BREACH_REST = 10 * MINUTE;
+
+array<BreachSite@> gBreachSites;
+float gStaticLostCum = 0.f;   // undecayed metal lost to static guns (deathledger NoteDeathSource)
+bool gBreachOn = false;
+int gBreachSite = -1;
+int gBreachAt = -999999;
+int gBreachLogAt = 0;
+int gBreachLosingAt = -999999;   // last update that read losing on their ground
+
+// THE AIR TRIED TOO (his 11-13: "none of your air can get past their defenses, your ground army can't get past"):
+// the strikes of the last rest period, as metal lost against metal they destroyed. Air that pays for itself is a
+// way through, and the front is not a siege while it does.
+int gAirRunAt = -999999;
+float gAirRunLostM = 0.f;
+float gAirRunKillM = 0.f;
+void BreachNoteAirRun(float lostM, float killedM)
+{
+	if (ai.frame - gAirRunAt > BREACH_REST) {
+		gAirRunLostM = 0.f;
+		gAirRunKillM = 0.f;
+	}
+	gAirRunAt = ai.frame;
+	gAirRunLostM += lostM;
+	gAirRunKillM += killedM;
+}
+bool AirGetsThrough()
+{
+	return (ai.frame - gAirRunAt <= BREACH_REST) && (gAirRunKillM >= gAirRunLostM);
+}
+
+bool BreachOn() { return gBreachOn && (gBreachSite >= 0); }
+
+bool BreachTarget(AIFloat3 &out at)
+{
+	if (!BreachOn())
+		return false;
+	at = gBreachSites[uint(gBreachSite)].pos;
+	return true;
+}
+
+bool BreachSiteFailed(const AIFloat3 &in p)
+{
+	for (uint i = 0; i < gBreachSites.length(); ++i) {
+		BreachSite@ s = gBreachSites[i];
+		if ((s.failedUntil > ai.frame) && (s.pos.distance2D(p) < BREACH_SITE_R))
+			return true;
+	}
+	return false;
+}
+
+// Any armed building of theirs that dies near a site counts toward breaking it, whoever killed it.
+void BreachNoteEnemyDeath(int d, const AIFloat3 &in pos)
+{
+	if ((d < 1) || (d > Catalog::gDefCount) || Catalog::gMobile[d] || (Catalog::gLandRange[d] <= 1.f)
+			|| (Catalog::gSurfT[d] <= 0.f) || (Catalog::gBuildsList[d].length() > 0))
+		return;
+	for (uint i = 0; i < gBreachSites.length(); ++i) {
+		if (gBreachSites[i].pos.distance2D(pos) < BREACH_SITE_R)
+			gBreachSites[i].killedM += Catalog::gCostM[d];
+	}
+}
+
+void BreachNewTry(BreachSite@ s, float seen)
+{
+	s.since = ai.frame;
+	s.seenM = seen;
+	s.killedM = 0.f;
+	s.lost0 = gStaticLostCum;
+}
+
+void UpdateBreach()
+{
+	if (ai.frame < gBreachAt + 10 * SECOND)
+		return;
+	gBreachAt = ai.frame;
+	if (ai.GetTunable("apex_breach", TUNE_BREACH) <= 0.f) {
+		gBreachOn = false;
+		gBreachSite = -1;
+		return;
+	}
+	// A FRONT WE CANNOT GET THROUGH NO MATTER HOW HARD WE TRY (his 11-13): at the site where their guns kill us we have
+	// already paid the wall's own armed metal to its guns, the wall still stands (under half of it destroyed), and our
+	// air is not getting through either. Two towers at minute 5 never qualify: they die or we have not paid their worth.
+	// Measured before this rule: a lost army fight named the nearest tower a wall (on in 34 of 48 ordinary seats); then
+	// a live turtle's 74-138k wall never qualified, because kills of its constructors read as winning and the army we
+	// planned outweighed the wall.
+	AIFloat3 at;
+	float r = 0.f, m = 0.f;
+	gBreachSite = -1;
+	bool on = false;
+	if (TurretTarget(at, r, m)) {
+		int best = -1;
+		float bestD = BREACH_SITE_R;
+		for (uint i = 0; i < gBreachSites.length(); ++i) {
+			const float d = gBreachSites[i].pos.distance2D(at);
+			if (d < bestD) {
+				bestD = d;
+				best = int(i);
+			}
+		}
+		if (best < 0) {
+			BreachSite s;
+			s.pos = at;
+			BreachNewTry(s, m);
+			gBreachSites.insertLast(s);
+			best = int(gBreachSites.length()) - 1;
+			if (gBreachSites.length() > 8) {
+				gBreachSites.removeAt(0);
+				--best;
+			}
+			AiLog(Factory::T() + "apex: breach-new t=" + ai.teamId + " site=" + int(at.x) + "," + int(at.z)
+				+ " armedM=" + int(m) + " reach=" + int(r));
+		}
+		BreachSite@ s = gBreachSites[uint(best)];
+		if (m > s.seenM)
+			s.seenM = m;
+		if ((s.seenM > 0.f) && (s.killedM >= 0.5f * s.seenM)) {
+			++s.broken;
+			AiLog(Factory::T() + "apex: breach-broken t=" + ai.teamId + " site=" + int(s.pos.x) + "," + int(s.pos.z)
+				+ " seenM=" + int(s.seenM) + " killedM=" + int(s.killedM) + " lostToGuns=" + int(gStaticLostCum - s.lost0)
+				+ " in=" + ((ai.frame - s.since) / SECOND) + "s");
+			BreachNewTry(s, m);
+		}
+		// The wall stays a siege while it stands: one good window does not end a try (11-12 A/B: the state flickered off
+		// and the 4x tool price with it). It ends a full try after the last failing reading.
+		if ((s.seenM > 0.f) && (gStaticLostCum - s.lost0 >= s.seenM) && !AirGetsThrough()) {
+			if (ai.frame - gBreachLosingAt >= BREACH_TRY)
+				s.since = ai.frame;
+			gBreachLosingAt = ai.frame;
+		}
+		on = (ai.frame - gBreachLosingAt < BREACH_TRY);
+		if (on && (ai.frame - s.since > BREACH_TRY)) {
+			++s.tries;
+			s.failedUntil = ai.frame + BREACH_REST;
+			AiLog(Factory::T() + "apex: breach-failed t=" + ai.teamId + " site=" + int(s.pos.x) + "," + int(s.pos.z)
+				+ " seenM=" + int(s.seenM) + " killedM=" + int(s.killedM) + " lostToGuns=" + int(gStaticLostCum - s.lost0)
+				+ " tries=" + s.tries);
+			BreachNewTry(s, m);
+		}
+		gBreachSite = best;
+	}
+	gBreachOn = on;
+	if (ai.frame >= gBreachLogAt) {
+		gBreachLogAt = ai.frame + 60 * SECOND;
+		string site = "-";
+		if (gBreachSite >= 0) {
+			BreachSite@ s = gBreachSites[uint(gBreachSite)];
+			site = int(s.pos.x) + "," + int(s.pos.z) + " seenM=" + int(s.seenM) + " killedM=" + int(s.killedM)
+				+ " try=" + ((ai.frame - s.since) / SECOND) + "s lostToGuns=" + int(gStaticLostCum - s.lost0)
+				+ " tries=" + s.tries + " broken=" + s.broken + (BreachSiteFailed(s.pos) ? " RESTING" : "");
+		}
+		AiLog(Factory::T() + "apex: breach-state t=" + ai.teamId + " on=" + (gBreachOn ? 1 : 0)
+			+ " bleedFwd=" + int(gBleedFwd) + " killFwd=" + int(gKillFwd) + " toGuns=" + int(gDeadToStatic)
+			+ " air=" + int(gAirRunKillM) + "/" + int(gAirRunLostM)
+			+ (AirGetsThrough() ? " AIR-THROUGH" : "")
+			+ " tac=" + Market::gTacWhy
+			+ " sites=" + gBreachSites.length() + " site=" + site);
+	}
+}
+
+}  // namespace Military
diff --git a/tools/provenance.py b/tools/provenance.py
new file mode 100644
index 00000000..1f761429
--- /dev/null
+++ b/tools/provenance.py
@@ -0,0 +1,76 @@
+"""What code a test ran (his 11-13: save the results, the commit they ran and every detail).
+
+capture() reads the repo: HEAD, branch, and the uncommitted work as one patch (tracked changes plus the untracked
+files under the AI, C++, gadget and scenario trees), saved once to results/patches/<sha>.patch so the exact code
+stays recoverable after the tree moves on. deploy_ai.py writes it beside every deployed variant as provenance.json;
+run_match.py copies each AI's into result.json. tools/ledger.py turns runs into results/ledger.md entries.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import subprocess
+from datetime import datetime
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parent.parent
+PATCHES = REPO / "results" / "patches"
+ROOTS = ("ai/Unstable", "cpp", "game-patches", "tools")
+FILE = "provenance.json"
+
+
+def _git(*args: str) -> str:
+    return subprocess.run(["git", *args], cwd=REPO, capture_output=True, text=True, encoding="utf-8",
+                          errors="replace").stdout
+
+
+def capture() -> dict:
+    head = _git("rev-parse", "HEAD").strip()
+    branch = _git("rev-parse", "--abbrev-ref", "HEAD").strip()
+    patch = _git("diff", "--binary", "HEAD", "--", *ROOTS)
+    untracked = [p for p in _git("ls-files", "--others", "--exclude-standard", "--", *ROOTS).splitlines() if p]
+    for p in sorted(untracked):
+        f = REPO / p
+        if f.is_file() and f.stat().st_size < 2_000_000:
+            patch += subprocess.run(["git", "diff", "--no-index", "--binary", "/dev/null", p], cwd=REPO,
+                                    capture_output=True, text=True, encoding="utf-8", errors="replace").stdout
+    sha = hashlib.sha256(patch.encode("utf-8", "replace")).hexdigest()[:12] if patch else ""
+    if sha:
+        PATCHES.mkdir(parents=True, exist_ok=True)
+        out = PATCHES / f"{head[:10]}-{sha}.patch"
+        if not out.exists():
+            out.write_text(patch, encoding="utf-8")
+    return {"head": head, "branch": branch, "dirty": bool(patch), "diff_sha": sha,
+            "patch": f"results/patches/{head[:10]}-{sha}.patch" if sha else "",
+            "captured": datetime.now().isoformat(timespec="seconds")}
+
+
+def write(dirs, **extra) -> dict:
+    p = dict(capture(), **extra)
+    for d in dirs:
+        d = Path(d)
+        if d.is_dir():
+            (d / FILE).write_text(json.dumps(p, indent=2), encoding="utf-8")
+    return p
+
+
+def read(d) -> dict | None:
+    f = Path(d) / FILE
+    if f.is_file():
+        try:
+            return json.loads(f.read_text(encoding="utf-8"))
+        except ValueError:
+            return None
+    return None
+
+
+def label(p: dict | None) -> str:
+    if not p:
+        return "?"
+    if p.get("release"):
+        return p["release"]
+    return p["head"][:10] + ("+" + p["diff_sha"] if p.get("dirty") else "")
+
+
+if __name__ == "__main__":
+    print(json.dumps(capture(), indent=2))
