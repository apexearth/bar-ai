diff --git a/luarules/gadgets/ai_namer.lua b/luarules/gadgets/ai_namer.lua
index 18024153d8..cddd8699ec 100644
--- a/luarules/gadgets/ai_namer.lua
+++ b/luarules/gadgets/ai_namer.lua
@@ -145,18 +145,19 @@ if gadgetHandler:IsSyncedCode() then
 
 			-- Get AI prefix based on AI type/version
 		local function getAIPrefix(teamID)
-			-- Spring.GetAIInfo returns multiple values: hostingPlayerID, shortName, version, options
-			local _, shortName, version, options = Spring.GetAIInfo(teamID)
+			-- Spring.GetAIInfo returns, in order:
+			--   skirmishAIID, name, hostingPlayerID, shortName, version, options
+			-- Binding fewer names than that silently shifts all of them. The old
+			-- code here read `name` into `shortName`, and since every AI name
+			-- contains "BARb", every variant rendered as "[BARb]".
+			local _, _, _, shortName, version = Spring.GetAIInfo(teamID)
 			shortName = tostring(shortName or "")
+			version = tostring(version or "")
 
-			-- shortName format is like "BARbapex(3)" or "BARbstable(3)"
-			-- Parse out the version from the shortName
-			if string.find(shortName, "BARbapex") then
-				return "[APEX] "
-			elseif string.find(shortName, "BARbstable") then
-				return "[BARb] "
-			elseif string.find(shortName, "BARb") then
-				return "[BARb] "
+			-- `version` is the AI/Skirmish/<shortName>/<version>/ folder, i.e.
+			-- exactly the variant under test: "stable", "apexsling", ...
+			if string.find(shortName, "BARb") then
+				return "[" .. string.upper(version) .. "] "
 			end
 
 			-- Check for Lua AIs
@@ -176,6 +177,9 @@ if gadgetHandler:IsSyncedCode() then
 					local prefix = getAIPrefix(teamID)
 					local baseName = getName(teamID, string.find(Spring.GetTeamLuaAI(teamID) or '', "Raptors"), string.find(Spring.GetTeamLuaAI(teamID) or '', "Scavenger"))
 					Spring.SetGameRulesParam('ainame_'..teamID, prefix .. baseName)
+					-- Echoed so headless logs carry the team -> variant mapping
+					-- the benchmark harness would otherwise have to infer.
+					Spring.Echo(string.format("[BARAI_NAME] team=%d name=%s", teamID, prefix .. baseName))
 				end
 			end
 			gadgetHandler:RemoveGadget(self)
