+IUnitTask::SLiveness IUnitTask::Probe(const IUnitTask* task)
+{
+	SLiveness res;
+	res.live = false;
+	res.known = false;
+	res.type = Type::NIL;
+	res.sub = -1;
+	if (!RegistryOn()) {
+		res.live = true;  // gate off: callers must behave exactly as before
+		return res;
+	}
