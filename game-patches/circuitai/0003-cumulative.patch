+	for (CCircuitDef& cdef : GetCircuitDefs()) {
+		if (cdef.GetDroneCount() <= 0) {
+			continue;
+		}
+		auto dit = defsByName.find(cdef.GetDroneName().c_str());
+		if (dit == defsByName.end()) {
+			continue;
