+			cdef.GetDroneName().c_str(), s0, cdef.GetSurfThreat(), a0, cdef.GetAirThreat());
+	}
+	std::string snipers;
+	for (const CCircuitDef& cdef : GetCircuitDefs()) {
+		if (cdef.IsSniper()) {
+			snipers += " " + std::string(cdef.GetDef()->GetName());
