+	const float off = (float(idx) - float(n - 1) * 0.5f) * LINE_SPACING;
+
+	// Perpendicular to the enemy direction.
+	AIFloat3 pos = centre;
+	pos.x += -fz * off;
+	pos.z +=  fx * off;
