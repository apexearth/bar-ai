+const char* IFighterTask::FightTypeName(int ft)
+{
+	static const char* NAMES[] = {
+		"RALLY", "GUARD", "DEFEND", "SCOUT", "RAID", "ATTACK", "BOMB",
+		"MELEE", "ARTY", "AA", "AH", "SUPPORT", "SUPER"
