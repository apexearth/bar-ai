+void* ICoreUnit::operator new(std::size_t sz)
+{
+	void* p = VirtualAlloc(nullptr, sz, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
+	if (p == nullptr) {
+		throw std::bad_alloc();
+	}
+	return p;
+}
