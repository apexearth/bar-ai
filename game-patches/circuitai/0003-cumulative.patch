+	}
+	CCircuitAI* circuit = manager->GetCircuit();
+	std::ostringstream cmd;
+	cmd << "ai_thr_data:";
+	cmd.write(reinterpret_cast<const char*>(influence), mapSize * sizeof(float));
+	std::string s = cmd.str();
+	circuit->GetLua()->CallRules(s.c_str(), s.size());
