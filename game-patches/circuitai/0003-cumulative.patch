+AIFloat3 CCircuitUnit::InFormation(const AIFloat3& p, OrdSrc src) const
+{
+	switch (src) {
+		case OrdSrc::TRAVEL: case OrdSrc::FWALK:
+		case OrdSrc::REGROUP: case OrdSrc::RALLY:
+			break;
+		default:
+			return p;
