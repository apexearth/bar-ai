+		}
+		circuit->LOG("apex: atgoal ft=%s samples=%u at=%u meandist=%.0f",
+				(i < n) ? IFighterTask::FightTypeName(i) : "OTHER",
+				sAtSamples[i], sAtGoal[i], sAtDist[i] / sAtSamples[i]);
+	}
