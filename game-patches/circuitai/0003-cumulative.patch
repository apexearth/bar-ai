+CAllyUnit* CCircuitAI::GetFriendlyUnit(Unit* u) const
+{
+	if (u->GetTeam() == teamId) {
+		return GetTeamUnit(u->GetUnitId());
+	} else if (u->GetAllyTeam() == allyTeamId) {
+		return allyTeam->GetFriendlyUnit(u->GetUnitId());
+	}
+
+	return nullptr;
