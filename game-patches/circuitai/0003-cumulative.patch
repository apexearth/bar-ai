+			? 0 : -buildDef->GetId();
+	int n = 0;
+	auto commands = unit->GetUnit()->GetCurrentCommands();
+	for (springai::Command* cmd : commands) {
+		const int id = cmd->GetId();
+		if ((id < 0) && ((wanted == 0) || (id == wanted))) {
+			++n;
+		}
+		delete cmd;
+	}
+	return n;
