+		return;
+	}
+	asIScriptContext* ctx = script->PrepareContext(mainInfo.unitDestroyedBy);
+	ctx->SetArgObject(0, unit);
+	ctx->SetArgObject(1, attackerDef);
+	script->Exec(ctx);
+	script->ReturnContext(ctx);
