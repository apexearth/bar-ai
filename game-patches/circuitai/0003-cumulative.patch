+				(buildDef != nullptr) ? buildDef->GetDef()->GetName() : "-", static_cast<void*>(this),
+				(tr == nullptr) ? "null" : (tr->IsFinished() ? "fin" : (tr->IsWait() ? "wait" : "act")));
+	}
 	Update(unit);
 }
 
