+			continue;  // an ally's ground; DefaultMakeDefence declines these too
+		}
+		const float dist = pos.SqDistance2D(enemyPos);
+		if (dist < bestDist) {
+			bestDist = dist;
+			best = &pos;
+		}
+	}
+	return (best == nullptr) ? basePos : *best;
