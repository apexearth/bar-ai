+	const AIFloat3& spotPos = spots[index].position;
+	if (!circuit->GetTerrainManager()->CanBeBuiltAt(def, spotPos)) {
+		return nullptr;
+	}
+	return mgr->Enqueue(TaskB::Spot(IBuilderTask::BuildType::MEXUP,
+			IBuilderTask::Priority::HIGH, def, spotPos, index));
+}
