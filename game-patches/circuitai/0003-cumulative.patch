+{
+	return IsPosOnMap(pos) ? GetInflMap()->GetEnemyInflAt(pos) : .0f;
+}
+
+float CCircuitAI::GetNetInflAt(const AIFloat3& pos) const
+{
+	return IsPosOnMap(pos) ? GetInflMap()->GetInfluenceAt(pos) : .0f;
+}
