+		++ordRep[kind][bucket];
+	}
+	if ((src >= 0) && (src < ORD_SRC_N)) {
+		++ordSrc[src][0];
+		if (bucket >= 0) {
+			++ordSrc[src][1];
+			if (bucket == 4) {
+				++ordSrc[src][2];
+			}
+		}
+	}
+}
