+		}
+		const float score = remaining / (from.distance2D(spot.pos) + squareSize);
+		if (score > bestScore) {
+			bestScore = score;
+			outSpot = int(i);
+		}
+	}
+	if (outSpot < 0) {
+		return false;
+	}
+	outPos = spots[outSpot].pos;
+	return true;
+}
