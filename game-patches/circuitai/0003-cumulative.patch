+		// apex_coward_hp (~60%) with plenty of fight left; counting them here
+		// would trip the 35% vote on a squad that is merely scuffed.
+		if ((u != unit) && (u->GetCircuitDef() != nullptr)
+			&& (u->GetHealthPercent() <= u->GetCircuitDef()->GetRetreat()))
