+	std::lock_guard<std::mutex> guard(RegLock());
+	const TaskTypeMap& live = LiveTasks();
+	TaskTypeMap::const_iterator it = live.find(task);
+	if (it != live.end()) {
+		res.live = true;
+		res.known = true;
+		res.type = it->second.type;
+		res.sub = it->second.sub;
