+	ctx->SetArgObject(0, edef);
+	ctx->SetArgAddress(1, &const_cast<springai::AIFloat3&>(pos));
+	ctx->SetArgByte(2, byUs ? 1 : 0);
+	script->Exec(ctx);
+	script->ReturnContext(ctx);
+}
