+IBuilderTask* CEconomyManager::EnqueueMexAt(CCircuitUnit* unit, int spotId)
+{
+	CMetalManager* metalMgr = circuit->GetMetalManager();
+	if ((unit == nullptr) || !metalMgr->IsValidSpot(spotId) || !IsAllyOpenMexSpot(spotId)) {
+		return nullptr;
