+bool IsTaskStale(CCircuitAI* circuit, CCircuitUnit* unit, const IUnitTask* task,
+		const char* at)
+{
+	const IUnitTask::SLiveness live = IUnitTask::Probe(task);
+	if (live.live) {
+		return false;
+	}
+	static int staleHits = 0;  // AI event path is single-threaded
