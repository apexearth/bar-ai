+	const float len2 = dx * dx + dz * dz;
+	const float t = (len2 > 1.f)
+			? utils::clamp(((p.x - a.x) * dx + (p.z - a.z) * dz) / len2, 0.f, 1.f) : 0.f;
+	const float ex = a.x + dx * t - p.x, ez = a.z + dz * t - p.z;
+	return ex * ex + ez * ez;
+}
