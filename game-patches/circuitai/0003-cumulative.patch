+void CMilitaryManager::NoteSuperTarget(const AIFloat3& pos, int frame)
+{
+	for (SSuperShot& shot : superShots) {
+		if (shot.frame + SUPER_MEMORY <= frame) {
+			shot.pos = pos;
+			shot.frame = frame;
+			return;
+		}
+	}
+	superShots.push_back(SSuperShot{pos, frame});
