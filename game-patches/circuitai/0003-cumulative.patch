+void IBuilderTask::ApplyPathUnbounded(const CQueryPathSingle* query)
+{
+	CCircuitUnit* unit = query->GetUnit();
+	if ((unit == nullptr) || (unit->GetTravelAct() == nullptr)) {
+		return;
+	}
+	if (query->GetPathInfo()->path.size() <= 2) {
+		OnNoPath(unit);
