+int CSetupData::FindAllyTeamOf(int teamId) const
+{
+	for (size_t i = 0; i < allyTeams.size(); ++i) {
+		if ((allyTeams[i] != nullptr) && (allyTeams[i]->GetTeamIds().count(teamId) > 0)) {
+			return int(i);
+		}
+	}
+	return -1;
+}
+
 } // namespace circuit
