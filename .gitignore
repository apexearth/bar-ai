# Upstream source checkouts -- clone with tools/bootstrap_sources.py, never commit
vendor/

# Tournament results, and the engine scratch dirs (write dirs, archive
# caches, demos) the harness runs matches in.
tournaments/
runtime/

# Match harness output: start scripts, infologs, replays, result JSON.
# matches/* rather than matches/ so the negation below actually applies -- git
# does not descend into an ignored directory, so !matches/.gitkeep would be dead.
matches/*
!matches/.gitkeep

# Build output for the C++ path
build/
dist/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Editors / OS
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini

# agent/session worktrees
.claude/worktrees/
scratch_*.log
