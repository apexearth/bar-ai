// Mono-space font required
{
"terrain": {
	"analyze": "armcom",

	// These constants control how to decide between Seas and Lakes.
	"lake_tiles": 100,  // 300,
	"lake_width_tiles": 10,  // 32,

	// At least area_min_tiles connected Tiles are necessary for an Area to be created.
	"area_min_tiles": 32,  // 64,

	"areas_merge_size": 64,  // 80,
	"areas_merge_altitude": 64  // 80  // 10 * altitude_scale
},

"building": {
	"class_land": {
		"fac_land": {
			// "type": [<blocker_shape>, <structure_type>]
			// Available blocker_shape: rectangle, circle.
			// Available structure_type: factory, mex, geo, pylon, convert, engy_low, engy_mid, engy_high, def_low, def_mid, def_high, special, nano, terra, unknown
			"type": ["rectangle", "factory"],

			// Unit of measurement: 1 size/yard/radius = SQUARE_SIZE * 2 = 16 elmos, integer.
			// Offset in South facing
			"offset": [0, 7],  // default: [0, 0]

			// Size of a blocker without yard
//			"size": [7, 7],  // default: size of a unit

			// Spacer, blocker_size = size + yard
			"yard": [8, 20],  // default: [0, 0]

			// Integer radius of a blocker or description string.
			// Available string values: explosion, expl_ally = [radius ~ 1 player .. radius/2 ~ 4+ players]
//			"radius": "expl_ally",  // default: "explosion"

			// "ignore": [<structure_type>, <structure_type>, ...]
			// Ignore specified structures.
			// Additional values: none, all
			"ignore": ["def_low"]  // default: ["none"]
//			"not_ignore": ["all"]  // default: ["all"]
		},
		"fac_land2": {
			"type": ["rectangle", "factory"],
			"offset": [0, 4],
			"yard": [-2, 42]
		},
		"fac_air": {
			"type": ["rectangle", "factory"],
			"ignore": ["nano", "engy_low", "engy_mid", "engy_high", "convert"]
		},
		"fac_water": {
			"type": ["rectangle", "factory"],
			"offset": [0, 4],
			"yard": [10, 12]
		},
		"fac_strider": {
			"type": ["rectangle", "factory"],
			"offset": [0, 12],
			// Flush on the flanks (his 2026-09-16 ruling); the apron ahead is
			// the exit.
			"yard": [0, 20],
			"ignore": ["nano"]
		},
		"solar": {
			"type": ["rectangle", "engy_low"],
 			"ignore": ["engy_low", "def_low", "nano"]
		},
		"wind": {
			// Flush like solar, not stock's 4-cell circle: winds are asked in
			// groups of ClusterN from one anchor (Market::GroupAnchor).
			"type": ["rectangle", "engy_low"],
			"ignore": ["engy_low", "def_low", "nano"]
		},
		"geo": {
			"type": ["rectangle", "geo"],
			"yard": [2, 2],
			"ignore": ["all"]
		},
		"geo2": {
			"type": ["rectangle", "geo"],
			"ignore": ["all"]
		},
		// Reactors stand flush too: the 6- and 8-cell circles kept only labs,
		// radar, guns and silos a hundred elmos off, never another reactor
		// (they ignored each other). Chain-blast spacing is FarmSlot's, by
		// cluster, not a yard. The apron of a lab is the lab's own yard.
		"fusion": {"type": ["rectangle", "engy_mid"], "not_ignore": ["factory", "mex", "geo", "terra"]},
		"singu": {"type": ["rectangle", "engy_high"], "not_ignore": ["factory", "mex", "geo", "terra"]},
		"pylon": {
			"type": ["circle", "pylon"],
			"not_ignore": ["factory", "pylon", "mex", "geo", "terra"]  // default: ["all"]
		},
		"store": {
			"type": ["rectangle", "mex"],
			"not_ignore": ["factory", "mex", "geo", "terra"]
		},
		"mex": {
			"type": ["rectangle", "mex"],
//			"offset": [0, -5],
			"yard": [2, 2],
			"ignore": ["all"]
		},
		"mex2": {
			"type": ["rectangle", "mex"],
			"ignore": ["all"]
		},
		"converter": {"type": ["rectangle", "convert"], "ignore": ["convert", "nano", "engy_low", "engy_mid", "engy_high"]},
		// A light turret's five-cell circle held every converter, storage,
		// radar and lab 80 elmos off it; the wall stands flush (apexearth
		// 2026-09-16: "you want things to be very tight").
		"def_low": {
			"type": ["rectangle", "def_low"],
			"not_ignore": ["factory", "mex", "geo", "terra"]
		},
		"caretaker": {"type": ["rectangle", "nano"], "ignore": ["def_low", "engy_low", "engy_mid", "engy_high", "convert"]},
		"superweapon": {
			"type": ["circle", "special"],
			"ignore": ["def_low", "engy_high"]
		},
		"protector": {
			"type": ["circle", "special"],
			"ignore": ["def_low", "engy_mid", "engy_high"]
		},
		"flush_special": {
			"type": ["rectangle", "special"],
			"ignore": ["nano", "engy_low", "engy_mid", "engy_high", "convert", "def_low", "special"]
		},
//		"terraform": {
//			"type": ["rectangle", "special"],
//			"size": [7, 7]  // int2(3 + 4, 3 + 4)
//		},
		"strider": {
			"type": ["rectangle", "special"],
			"yard": [4, 4],
			"ignore": ["all"]
		},
		"small": {
			"type": ["rectangle", "unknown"],
			"not_ignore": ["factory", "mex", "geo", "terra"]
		},
		"wall": {
			"type": ["rectangle", "def_low"],
			"not_ignore": ["factory", "mex", "geo", "terra"]
		},
		// A jammer or an advanced radar stands flush: the default six-cell
		// yard left a 96-elmo ring of dead ground around every jammer (his
		// watched game, 2026-09-15).
		"flush_sense": {
			"type": ["rectangle", "unknown"],
			"not_ignore": ["mex", "geo"]
		},
		// Everything unlisted -- the heavier guns, anti-air, big guns --
		// stood in a six-cell dead ring that refused every farm cell around
		// it. Nothing but a lab's apron keeps ground now -- and the metal and
		// geo spots, which are blockers of type mex/geo: a list that leaves
		// them out puts the tower ON the spot (watched 2026-09-20).
		"_default_": {
			"type": ["rectangle", "unknown"],
			"not_ignore": ["factory", "mex", "geo", "terra"]
		}
	},
	// Water overrides land. Map considered as water if amount of land < 40%
	"class_water" : {
		"wind": {
			"type": ["rectangle", "engy_low"],
			"ignore": ["engy_low"]
		}
	},
	"instance": {
		"fac_land": ["armlab", "armalab", "armvp", "armavp", "coralab", "corvp", "coravp", "leglab", "legalab", "legvp", "legavp"],
		"fac_land2": ["corlab", "armhp", "armfhp", "corhp", "corfhp", "leghp", "legfhp"],
		"fac_air": ["armap", "corap", "armaap", "coraap", "legap", "legaap"],
		"fac_water": ["armsy", "armasy", "armamsub", "armplat", "corsy", "corasy", "coramsub", "corplat"],
		"fac_strider": ["armshltx", "armshltxuw", "corgant", "corgantuw", "leggant"],
		"solar": ["armsolar", "corsolar", "legsolar"],
		"wind": ["armwin", "corwin", "armtide", "cortide", "legwin"],
		"geo": ["armgeo", "corgeo", "leggeo"],
		"geo2": ["armageo", "corageo", "legageo"],
		"fusion": ["armadvsol", "coradvsol", "legadvsol"],
		"singu": ["armfus", "armuwfus", "armckfus", "armafus", "corfus", "coruwfus", "corafus", "legfus", "legafus"],
		"store": ["armmstor", "armestor", "cormstor", "corestor", "legmstor", "legestor"],
		"mex": ["armmex", "cormex", "legmex"],
		"mex2": ["armmoho", "cormoho", "armuwmme", "coruwmme", "legmoho"],
		"converter": ["armmakr", "cormakr", "armmmkr", "cormmkr", "armfmkr", "corfmkr", "armuwmmm", "coruwmmm", "legeconv", "legadveconv"],
		"def_low": ["armllt", "armclaw", "corllt", "cormaw", "leglht", "legdtr"],
		"caretaker": ["armnanotc", "armnanotcplat", "cornanotc", "cornanotcplat", "legnanotc"],
		"small": ["armrad", "corrad", "armfrad", "corfrad", "legrad", "legfrad"],
		"wall": ["armdrag", "cordrag", "legdrag"],
		"flush_sense": ["armjamt", "corjamt", "legjam", "armveil", "corshroud", "armarad", "corarad", "legarad"],
		"flush_special": ["armsilo", "corsilo", "legsilo", "armamd", "corfmd", "legabm", "armtarg", "cortarg", "legtarg"]
	}
}
}
