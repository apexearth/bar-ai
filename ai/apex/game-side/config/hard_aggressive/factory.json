			"tier5": [ 0.15,    0.00,    0.05,       0.00,      0.00,     0.00,      0.00,     0.10]
		},
		"air": {
			"tier0": [ 0.25,    0.64,    0.09,       0.00,      0.00,     0.10,      0.00,     0.30],
			"tier1": [ 0.25,    0.70,    0.10,       0.00,      0.06,     0.10,      0.00,     0.20],
