// Factory.json is shared between allyTeam
{
// Factory selection parameters

"select": {
	"air_map": 100,
	"offset": [-20, 20],
	// Speed factor: 8x8 ~ 0%, 24x24 ~ 40%
	"speed": [0, 40],
	"map": [8, 24],
	"no_air": 1,
	"min_land": 40.0
},

"warn_probability": false,

// Cheap units keep a share in the high income tiers on purpose. Spam buys map
// vision and pulls fire - a Titan spending a salvo on a 21-metal Flea is a salvo
// it did not spend on a Bull. Stock zeroes those columns from the mid tiers up,
// and apex reaches T2 at ~5.7 min (30 games, 4v4), so the tiers where the column
// is zero are the ones it spends nearly the whole match in. Riot units in the
// same rows (armflash, corgator, armwar, corpyro) are held at a few percent for
// the mirror case, when the enemy is the one spamming.
"factory": {

//########################################################################################################################
//####|| ARMADA FACTORY LAND ||###########################################################################################
//########################################################################################################################

	"armlab": {
		// Adjusts the priority of factory choice (factories with map_percent < 20 are ignored)
		// map_percent is [20..100]
		// On start:
		//   if factory has available builder in current frame: priority ~= map_percent * importance0 + random(-20..+20)
		//   if factory's builder unavailable in current frame: priority ~= map_percent * importance0 / 10 + random(-20..+20)
		// During game: priority ~= map_percent * importance1 + random(-20..+20)
		// importanceN = 1.0 by default if not set
		"importance": [1.0, 0.0],
			// 'require_energy' adds energy requirement for tierN (N>0): fallback to lowest tier on low energy
		"require_energy": false,
			// If income*ecoFactor < income_tier[N] then 'tierN' probability will be used
		"income_tier": [2, 25,  35],
			"unit":      ["armck", "armpw", "armrectr", "armrock", "armham", "armjeth", "armwar", "armflea"],
			// armck reverted to the pre-session value (see below), then pushed
			// FURTHER at tier2/3 (0.35 -> 0.45). Issue 59: stock BARb's own
			// Armada expands ~17-35% faster than its own Cortex (mex count at
			// minute 12/20, comparing stock-vs-Cortex to stock-vs-Armada) --
			// apex-Armada's own performance is only mildly behind apex-Cortex's
			// (~11% at minute 12), so matching Cortex-derived "proven" values
			// (armck was already ABOVE corck's flat 0.05 even before this push)
			// was never enough: the target was never parity with Cortex, it was
			// beating a genuinely tougher stock opponent. Untested -- confirm
			// with an Armada,Armada batch.
			// armck cut to flat 0.05 (matching corck) regressed hard: an
			// Armada,Armada 4v4 timeline (analyze_stats.py) showed mex count
			// dead even with stock through minute 6 (3.8 vs 3.8), then apex
			// falling behind by minute 8 (5.0 vs 6.2) and badly by minute 10
			// (6.2 vs 9.1) -- entirely in the T1 window, before T2 constructors
			// even exist for either side (conT2=0 for both through minute 10).
			// conT1 (T1 constructors alive) shows the same early divergence
			// (3.5 vs 4.6 at minute 6). Reverting armack alone (T2, above) did
			// NOT fix the win rate or the timeline -- this T1 cut is the actual
			// driver: fewer T1 constructors directly means slower mex placement,
			// which is where the whole game's economic gap actually starts.
			// Reverted to the pre-session value.
			"land": {
			"tier0": [0.25, 0.70, 0.12, 0.00, 0.00, 0.00, 0.00, 0.30],
			"tier1": [0.25, 0.55, 0.12, 0.00, 0.25, 0.02, 0.00, 0.18],
			"tier2": [0.45, 0.45, 0.12, 0.00, 0.22, 0.02, 0.04, 0.14],
