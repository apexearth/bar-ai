// Mono-space font required
// Factory.json is shared between allyTeam
{
// Factory selection parameters
"select": {
	"air_map": 100,
	"offset": [-20, 20],
	"speed": [0, 40],  	// Speed factor: 8x8 ~ 0%, 24x24 ~ 40%
	"map": [8, 24],
	"no_air": 1,	//how many players have to start with non-air factories before ai considering starting the game with air factories
	"min_land": 75.0 //minimum percent of land to consider map as land. 
},

// Utility param: warning on unit's total probability not equal to 100%
"warn_probability": false,

// Define factories
"factory": {
	"armlab": {
		// Adjusts the priority of factory choice (factories with map_percent < 20 are ignored)
		// map_percent is [20..100]
		// On start:
		//   if factory has available builder in current frame: priority ~= map_percent * importance0 + random(-20..+20)
		//   if factory's builder unavailable in current frame: priority ~= map_percent * importance0 / 10 + random(-20..+20)
		// During game: priority ~= map_percent * importance1 + random(-20..+20)
		// importanceN = 1.0 by default if not set
		"importance": [1.0, 0.2],

		// 'require_energy' adds energy requirement for tierN (N>0): fallback to lowest tier on low energy
		"require_energy": false,

		// If income*ecoFactor < income_tier[N] then 'tierN' probability will be used
		"income_tier": [2, 25,  35, 50, 100],

		"unit":      ["armck", "armpw", "armrectr", "armrock", "armham", "armjeth", "armwar", "armflea"],

		// armjeth (index 5) is a dedicated AA bot: onlytargetcategory VTOL, no
		// ground weapon at all -- against a ground army it is not diversity,
		// it is dead weight. response.json's enemy_air_metal term already
		// correctly scales it up from genuine air threat (confirmed 0 when
		// airRaw=0). A flat 0.02-0.06 baseline here does not need any air
		// present to draw: measured 2026-08-15, a full land-map game with
		// airRaw=0 the ENTIRE match still accumulated armjeth 375->1250
		// metal by minute 22, matching apexearth's repeated report ("8 AA
		// units... enemy has us countered... AA weren't thugs or centurions
		// which would be capable of defending us") even after the first cut.
		// Zeroed in "land" (what this measurement covers); air/water tables
		// below untouched -- no evidence gathered there yet.
		//
		// armpw (index 1, Pawn) held 0.30 through tier2/3/4 (income
		// 25-100 -- most of a real game's mid-to-late stretch), by far the
		// largest single share of this lab at every tier except the very
		// top. Same shape as the pre-fix Hound bug: a cheap early-game raider
		// never tapering down as income grows into the range where the
		// enemy fields real T1/T2 answers. Measured 2026-08-15: armpw
		// cumulative metal (3024) dwarfed every other combat unit at 15-20
		// minutes -- apexearth, watching: "they're really worthless at this
		// point of the game... we need thugs, rocket bots, etc." Tapered
		// tier2/3/4 down toward tier5's already-correct near-zero, same
		// smoothing-not-cliff approach as the Hound fix; tier0/1 (the
		// legitimate early raider window) left at 0.70.
		"land": {
			"tier0": [ 0.25,    0.70,    0.05,       0.00,      0.20,     0.00,      0.00,     0.30],
			// Income 2-25 is minutes ~2-13 of a real 1v1, and this row held
			// ONLY a raider (measured 2026-08-20: mix-diag r2-ok-rest-null all
			// game, army 100% Pawn while corlab's same row fields Storm+Thud).
			// Cortex-parity core: Rocko/Hammer/Warrior at corlab-t1-like shares.
			"tier1": [ 0.25,    0.45,    0.05,       0.20,      0.30,     0.00,      0.15,     0.30],
			"tier2": [ 0.35,    0.10,    0.05,       0.15,      0.45,     0.00,      0.10,     0.10],
