		"defence": {
			// The only jammers in this profile used to hang off armanni/cordoom, which are
			// porcupine index 12 - last in "land" and, until this edit, 30 min into "base".
			// Neither ever completed in 30 measured games, so the 0.8 chance below was never
			// rolled even once. armhlt/corhlt are the first heavy tower every side actually
			// finishes (base index 4, the T2 factory hubs and the radar hubs below), which makes
			// them the reliable marker for "this is a defended position, hide it".
			// Gated later than the radar-hub jammers below so the two hooks mostly cover different
			// parts of the game instead of stacking two jammers on one position.
			"armhlt": {
				"hub": [[
					{"unit": "armjamt", "category": "defence", "offset": {"back": 90}, "condition": {"m_inc>": 14}, "priority": "low"}
				]]
			},
			"corhlt": {
				"hub": [[
