		},
		"weight":     [    0.5,      0.1  ],

		"condition": [40, 600]  // [<Minimum income>, <maximum seconds to build>]
	},

	// Fallback defence
	"default": {
		"armada": "armllt",
		"cortex": "corllt"
	}
},



