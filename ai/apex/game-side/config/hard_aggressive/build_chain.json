					],  // chain2
					// coradvsol alone is 10% of measured spend, so this is the densest hook onto
					// the energy farm - one assist turret per solar once income is genuinely large.
					[
						{"unit": "cornanotc", "category": "nano", "offset": {"back": 70}, "condition": {"m_inc>": 16}, "priority": "normal"}
					]
				]
			},
			"corfus": {
				"hub": [
					[  
						{"unit": "cornanotc", "category": "nano", "offset": {"front": 5}, "priority": "now"},
						{"unit": "cornanotc", "category": "nano", "offset": {"front": 10}, "priority": "now"},
						{"unit": "cornanotc", "category": "nano", "offset": {"front": 15}, "priority": "now", "condition": {"m_inc>": 10}},
						{"unit": "cornanotc", "category": "nano", "offset": {"front": 20}, "priority": "now", "condition": {"m_inc>": 14}},
						{"unit": "cornanotc", "category": "nano", "offset": {"front": 25}, "priority": "now", "condition": {"m_inc>": 18}},
						{"unit": "cormmkr", "category": "convert", "offset": [110, 110]},
						{"unit": "cormmkr", "category": "convert", "offset": [110, -110]},
						{"unit": "corflak", "category": "defence", "offset": {"front": 120}, "condition": {"air": true}}
					],
					// Own chain so it starts at once; a fusion is the point where corjamt's 5200e
