// Mono-space font required
{
"economy": {
	"energy": {
		// If land area >= 40% of the map then "land" config used, "water" otherwise
		"land": {
			// "<energy_def>": [<lower limit>, <upper limit>, <m-income>, <e-income>, <efficiency>]
			// limit = random(<lower limit>..<upper limit>)
			// The <e-income> field on the fusions is set rather than left blank.
			// CEconomyManager::InitEconomyScores defaults it to costE*cost_ratio
			// when absent, and UpdateEnergyTasks then halves the measured income
			// while energy-stalling before the comparison.
			"armwin": [200, 300],
			"armsolar": [80, 120],
			"armadvsol": [80, 120],
			"armfus": [30, 40, 41, 300],
			"armafus": [200, 300],

			"corwin": [200, 300],
			"corsolar": [80, 120],
			"coradvsol": [80, 120],
			"corfus": [30, 40, 42, 300],
			"corafus": [200, 300]
		},
		"water": {
			"armtide": [140, 250],
			"armwin": [100, 200],
			"armsolar": [10],
			"armadvsol": [120, 160],
			"armuwfus": [100, 200, 45, 320],

			"cortide": [140, 250],
			"corwin": [100, 200],
			"corsolar": [10],
			"coradvsol": [120, 160],
			"coruwfus": [100, 200, 46, 320]
		},
		// income factor for energy, time is in seconds
		// [[<start_factor>, <start_time>], [<end_factor>, <end_time>]]
		// LEFT AT STOCK ON PURPOSE. Raising this does not buy more energy --
		// tested 1.0 (stock), 2.0 and 10.0 on 20-minute 4v4s and energy income
		// never rose: avg e/s at 5m/8m/12m/16m came out 135/246/371/592 stock,
		// 126/210/276/494 at 2.0 and 125/173/323/454 at 10.0. No upward signal at
		// any setting, so do not reach for this lever again.
		//
		// Why it cannot work: CEconomyManager does
		//   metalIncome = min(metalIncome, energyIncome) * energyFactor
		// and METAL is the binding term early (~13/s against ~130 e/s), so the
		// factor scales metal income, not energy. Even 10x, which by the task
		// formula (taskSize < buildPower / costM * 4 + 1) should have allowed 4
		// concurrent solars at 5 min instead of 1, changed nothing -- so the
		// allowance was never the constraint. Metal is.
		//
		// The real ceiling is arithmetic, the same shape as the T3 one in
		// CLAUDE.md. Real costs: solar 155m for 20 e/s, advsol 350m for 75,
		// fusion 4300m for 1000. So 800 e/s of solars is 6200 metal -- five to
		// eight minutes of an AI's ENTIRE metal income at the 13-30 m/s it earns.
		// More energy has to come from better energy per metal (wind at 40m, then
		// advsol at 0.21 e/m, then fusion at 0.23) or from more metal, never from
		// this number.
		"factor": [[1.0, 300], [30.0, 7200]],

		"min_income": 5,  // minimum energy income to filter out generators

		"cost_ratio": 0.05,  // default condition, minimum energy income to cost ratio

		"em_ratio": 0.08,  // energy to metal ratio, used with UnitDef.build_speed

		"link_inc": 16.0,  // minimum metal-income for energy linking
		"pylon": []
	},

	"cluster_range": 800.0,  // 950.0  // maximum distance between 2 points in hierarchical cluster

	"geo": {
		"armada": "armgeo",
		"cortex": "corgeo",
		"legion": "armgeo"
	},
	"mex": {
		"armada": "armmex",
		"cortex": "cormex",
		"legion": "armmex"
	},
	"mex_up": 10,  // maximum number of simultaneous mex upgrades

	"calc_mex": false,  // always calculate mex spots (global)

	"goal_exec": 42.0,  // targeted time to finish non-build task, in seconds
	"build_mod": 1000.0,  // default build_mod for UnitDef, if it's not specified

	// Scales metal income
	// ecoFactor = teamSize*eps_step+(1-eps_step)
	"eps_step": 0.2,

	// Mobile buildpower to metal income ratio.
	//
	// apexearth: "we need cons to make the eco and defenses, always have enough of
	// these so we can make everything we need". This is that rule expressed as a
	// SHARE rather than another rule that claims a constructor -- CFactoryManager
	// ::UpdateBuildPower stops making builders once GetBuildPower() reaches
	// metalIncome * this, so it is already proportional and already self-limiting.
	//
	// 1.2 is what stock BARb's hard and hard_aggressive both use, and measured over
	// 8 games we ended on 10 constructors to stock's 37 and 3.0% of metal against
	// its 8.9% -- so matching stock's ratio was not producing stock's build power.
	// 1.5 is the value BARb's own root economy.json carries.
	"buildpower": 1.5,  // was 1.2, stock's; root default is 1.5

	// Metal excess to income ratio, -1 to disable
	"excess": -1.0,

	// Mobile constructor to static constructor metal pull ratio
	// [[<value>, <start_mex_percent>], [<value>, <end_mex_percent>]]
	"ms_pull": [[0.57, 0.0], [0.66, 0.34]],

	// Max percent of mexes circuit team allowed to take.
	// If its <1.0 then expansion obeys ms_pull rule, if >=1.0 then ms_pull doesn't affect expansion (mex, pylon, energy).
	// [<cap_percent>, <is_ally_cap>]
	"mex_max": [2.0, false],  // 200%

	// Construction order delay in seconds, -1 to disable
	// [[<start_delay>, <start_time>], [<end_delay>, <end_time>]]
	"build_delay": [[-1.0, 0], [-1.0, 0]],

	// [0] - metal-expenditure multiplier for build condition of new factory or assistant 
	// [1] - energy-expenditure multiplier for build condition of new factory or assistant
	// [2] - multiplier for total factory metal-expenditure, used as condition for new factory or assistant
	// [3] - multiplier for total factory energy-expenditure, used as condition for new factory or assistant
	"production": [0.9, 0.7, 0.8, 0.8],

	//"terra": "armsy",
	"assist": {
		"armada": "armnanotc",
		"cortex": "cornanotc"
	},

	// Unknown UnitDef replacer
	"default": {
		"armada": "armwin",
		"cortex": "corwin",
		"legion": "armwin"
	}
}
}
